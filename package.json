{
  "name": "tutorial-tool",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for create-tutorial CLI and the default Astro template.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter ./templates/default dev",
    "cli:build": "pnpm --filter ./packages/create-tutorial build",
    "template:dev": "pnpm --filter ./templates/default dev",
    "template:build": "pnpm --filter ./templates/default build",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
