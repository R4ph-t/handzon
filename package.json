{
  "name": "handzon",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the create-handzon CLI and the default Astro template.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter ./templates/default dev",
    "cli:build": "pnpm --filter ./packages/create-handzon build",
    "template:dev": "pnpm --filter ./templates/default dev",
    "template:build": "pnpm --filter ./templates/default build",
    "test": "pnpm -r test",
    "check": "biome check .",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
