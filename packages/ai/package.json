{
  "name": "handzon-ai",
  "version": "0.2.0",
  "description": "Standalone AI backend for Handzon (Hono + Mastra). Exposes /chat and /healthz.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "r4ph_t",
  "homepage": "https://github.com/R4ph-t/handzon#readme",
  "bugs": {
    "url": "https://github.com/R4ph-t/handzon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/R4ph-t/handzon.git",
    "directory": "packages/ai"
  },
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "handzon-ai": "./dist/server.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/google": "^3.0.75",
    "@ai-sdk/openai": "^3.0.64",
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@hono/node-server": "^2.0.3",
    "@mastra/core": "^1.35.0",
    "@mastra/memory": "^1.18.2",
    "dotenv": "^16.4.7",
    "hono": "^4.12.21",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
