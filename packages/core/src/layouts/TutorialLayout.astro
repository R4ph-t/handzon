---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import StepHeroMedia from "../components/StepHeroMedia.astro";
import StepNav from "../components/StepNav.astro";
import { parseStepId } from "../lib/content.ts";
import type { TutorialEntry, StepEntry } from "../lib/content";
import type { TutorialSummary } from "../lib/tutorialSummary";

interface Props {
  tutorial: TutorialEntry;
  steps: StepEntry[];
  currentStep: StepEntry;
  currentStepSlug: string;
  hasCheckpoint?: boolean;
  hasQuiz?: boolean;
  siteName?: string;
  tagline?: string;
  logoUrl?: string;
  logoWidth?: number;
  logoHeight?: number;
  faviconUrl?: string;
  repoUrl?: string;
  siteUrl?: string;
  siteCreditLabel?: string;
  nextTutorial?: TutorialSummary;
  /** Set false to drop the built-in footer and supply your own. */
  showFooter?: boolean;
}

const {
  tutorial,
  steps,
  currentStep,
  currentStepSlug,
  hasCheckpoint = false,
  hasQuiz = false,
  siteName,
  tagline,
  logoUrl,
  logoWidth,
  logoHeight,
  faviconUrl,
  repoUrl,
  siteUrl,
  siteCreditLabel,
  nextTutorial,
  showFooter = true,
} = Astro.props;

const stepSlugs = steps.map((s) => parseStepId(s.id).stepSlug);
const trackBootstrap =
  tutorial.data.tracks.length > 0
    ? `(() => {
  try {
    const tracks = ${JSON.stringify(tutorial.data.tracks).replace(/</g, "\\u003c")};
    const defaultTrack = ${JSON.stringify(tutorial.data.defaultTrack ?? null)};
    const ids = tracks.map((track) => track.id);
    const raw = window.localStorage.getItem("handzon:v1");
    const preferred = raw ? JSON.parse(raw)?.prefs?.track : null;
    const active = ids.includes(preferred)
      ? preferred
      : defaultTrack && ids.includes(defaultTrack)
        ? defaultTrack
        : ids[0];
    if (!active) return;
    document.documentElement.dataset.track = active;
    let style = document.getElementById("handzon-track-style");
    if (!style) {
      style = document.createElement("style");
      style.id = "handzon-track-style";
      document.head.appendChild(style);
    }
    style.textContent = '[data-track-panel]:not([data-track-panel="' + active + '"]) { display: none !important; }';
  } catch {
    // Track selection is progressive enhancement; leave all content visible on failure.
  }
})();`
    : null;
---
<BaseLayout
  title={`${currentStep.data.title} — ${tutorial.data.title}`}
  description={currentStep.data.summary}
  siteName={siteName}
  tagline={tagline}
  logoUrl={logoUrl}
  logoWidth={logoWidth}
  logoHeight={logoHeight}
  faviconUrl={faviconUrl}
  repoUrl={repoUrl}
  siteUrl={siteUrl}
  siteCreditLabel={siteCreditLabel}
  showFooter={showFooter}
>
  <slot name="head" slot="head" />
  {trackBootstrap && <script is:inline set:html={trackBootstrap} />}
  <div class="layout">
    <div class="sidebar-wrap">
      <Sidebar tutorial={tutorial} steps={steps} currentStepSlug={currentStepSlug} />
    </div>

    <main class="main">
      <header class="step-head">
        <div class="crumb">{tutorial.data.title}</div>
        <h1 class="step-title">{currentStep.data.title}</h1>
        {currentStep.data.duration && (
          <div class="step-dur">⏱ {currentStep.data.duration}</div>
        )}
      </header>

      {currentStep.data.heroMedia && (
        <StepHeroMedia media={currentStep.data.heroMedia} />
      )}

      <article class="prose">
        <slot />
      </article>

      <StepNav
        tutorialSlug={tutorial.id}
        steps={steps}
        currentStepSlug={currentStepSlug}
        gated={tutorial.data.gated}
        hasCheckpoint={hasCheckpoint}
        hasQuiz={hasQuiz}
        nextTutorial={nextTutorial}
      />

      {tutorial.data.feedbackUrl && (
        <footer class="step-foot">
          <a href={tutorial.data.feedbackUrl} target="_blank" rel="noopener">
            Report an issue with this tutorial →
          </a>
        </footer>
      )}
    </main>
  </div>

  <div
    id="tt-route"
    data-tutorial-slug={tutorial.id}
    data-step-slug={currentStepSlug}
    data-tutorial-gated={tutorial.data.gated ? "true" : "false"}
    data-tutorial-title={tutorial.data.title}
    data-tutorial-steps={JSON.stringify(stepSlugs)}
    hidden
  ></div>
  {/*
    Raw MDX source of the current step + selected metadata. CopyPrompt,
    "Copy step as Markdown", deep-link row, and the BYOA touchpoints
    read this at click time. Replacing "<" with "<" inside JSON
    keeps a stray "</script>" or "<!--" in the step body from
    terminating the script tag early.
  */}
  <script
    id="tt-step-data"
    type="application/json"
    set:html={JSON.stringify({
      tutorialSlug: tutorial.id,
      tutorialTitle: tutorial.data.title,
      stepSlug: currentStepSlug,
      stepTitle: currentStep.data.title,
      stepSource: currentStep.body ?? "",
    }).replace(/</g, "\\u003c")}
  ></script>
  <script>
    // Record last-visited + popularity markers from a data marker
    // (set in the markup above). Using a normal <script> + relative
    // import so Vite resolves the path alias correctly; define:vars +
    // dynamic import("~/...") bypasses Vite's resolver and the browser
    // can't load the module.
    import { withBase } from "../lib/base";
    import { firstIncompletePrerequisite } from "../lib/progress/gating";
    import { getStore } from "../lib/progress/local";
    import { deriveStepCompletion } from "../lib/progress/stepCompletion";
    import type { StepKey } from "../lib/progress/types";
    const route = document.getElementById("tt-route");
    if (route) {
      const tutorialSlug = route.dataset.tutorialSlug!;
      const stepSlug = route.dataset.stepSlug!;
      const stepKey = `${tutorialSlug}/${stepSlug}` as StepKey;
      const tutorialSteps = JSON.parse(
        route.dataset.tutorialSteps ?? "[]",
      ) as string[];
      const store = getStore();
      const redirectStep =
        route.dataset.tutorialGated === "true"
          ? firstIncompletePrerequisite({
              tutorialSlug,
              stepSlugs: tutorialSteps,
              stepSlug,
              steps: store.get().steps,
            })
          : undefined;

      if (redirectStep && redirectStep !== stepSlug) {
        window.location.replace(withBase(`/${tutorialSlug}/${redirectStep}`));
      } else {
        // Mark last-visited + tutorial "started" on every mount. The
        // started branch is idempotent: it only writes the timestamp the
        // first time per learner, so /api/progress sees one POST per
        // tutorial — not one per page view.
        store.set((s) => {
          const nextLastVisited = {
            ...s.lastVisited,
            [tutorialSlug]: { step: stepSlug, ts: Date.now() },
          };
          if (s.tutorials[tutorialSlug]?.started) {
            return { ...s, lastVisited: nextLastVisited };
          }
          return {
            ...s,
            lastVisited: nextLastVisited,
            tutorials: {
              ...s.tutorials,
              [tutorialSlug]: {
                ...s.tutorials[tutorialSlug],
                started: Date.now(),
              },
            },
          };
        });

        function readCompletionItemIds(selector: string, attr: string) {
          const activeTrack = document.documentElement.dataset.track;
          const ids = Array.from(document.querySelectorAll<HTMLElement>(selector))
            .map((el) => {
              const trackPanel = el.closest<HTMLElement>("[data-track-panel]");
              if (activeTrack && trackPanel?.dataset.trackPanel !== activeTrack) return null;
              return el.dataset[attr];
            })
            .filter((id): id is string => !!id);
          return Array.from(new Set(ids));
        }

        function recomputeStepCompletion() {
          const completion = deriveStepCompletion(store.get(), {
            quizIds: readCompletionItemIds("[data-quiz-id]", "quizId"),
            checkpointIds: readCompletionItemIds("[data-checkpoint-id]", "checkpointId"),
          });
          if (completion === null) return;
          store.set((s) => {
            if (s.steps[stepKey] === completion) return s;
            return { ...s, steps: { ...s.steps, [stepKey]: completion } };
          });
        }

        recomputeStepCompletion();
        document.addEventListener("hz:step-item", recomputeStepCompletion);
        store.subscribe(recomputeStepCompletion);

        // Watch for tutorial completion: once every step in the embedded
        // list flips to "complete", record the "completed" event exactly
        // once. Re-runs on store changes so finishing the last step on a
        // mid-tutorial page (rare) still triggers it.
        function checkCompletion() {
          const s = store.get();
          if (s.tutorials[tutorialSlug]?.completed) return;
          if (tutorialSteps.length === 0) return;
          const allDone = tutorialSteps.every(
            (slug) => s.steps[`${tutorialSlug}/${slug}` as `${string}/${string}`] === "complete",
          );
          if (allDone) {
            store.set((cur) => ({
              ...cur,
              tutorials: {
                ...cur.tutorials,
                [tutorialSlug]: {
                  ...cur.tutorials[tutorialSlug],
                  completed: Date.now(),
                },
              },
            }));
          }
        }
        checkCompletion();
        store.subscribe(checkCompletion);
      }
    }
  </script>
</BaseLayout>

<style>
  /* Draw the sidebar/main divider as a background line on the grid
   * itself: 1px-thin vertical strip at the sidebar column boundary,
   * from the top of the layout to the bottom. The grid auto-stretches
   * to fit its content, so the line runs all the way down to the
   * footer regardless of step length — without piggybacking on the
   * (sticky, viewport-height) sidebar's own border.
   *
   * `--sb-w` keeps the column track and the divider stop in lockstep
   * so widening the sidebar at one breakpoint doesn't desync the line. */
  .layout {
    --sb-w: 280px;
    display: grid;
    grid-template-columns: var(--sb-w) minmax(0, 1fr);
    min-height: 100dvh;
    background: linear-gradient(
      to right,
      transparent var(--sb-w),
      var(--color-border) var(--sb-w),
      var(--color-border) calc(var(--sb-w) + 1px),
      transparent calc(var(--sb-w) + 1px)
    ) no-repeat;
  }
  @media (min-width: 1280px) {
    .layout { --sb-w: 320px; }
  }
  .sidebar-wrap {
    position: sticky;
    top: var(--hz-nav-height, 3rem);
    height: calc(100dvh - var(--hz-nav-height, 3rem));
  }
  .main {
    padding: 2rem clamp(1rem, 4vw, 4rem);
    /* Keep tutorial pages roomy enough for code-heavy components. Prose
     * itself is constrained below so paragraphs do not become too wide. */
    max-width: 86ch;
  }
  .main > .prose {
    max-width: 100%;
  }
  .main > .prose > :where(p, ul, ol, blockquote, h2, h3, h4, h5, h6) {
    max-width: 80ch;
  }
  @media (min-width: 1280px) {
    .main { max-width: 104ch; }
  }
  @media (min-width: 1600px) {
    .main { max-width: 118ch; }
  }
  @media (min-width: 1920px) {
    .main { max-width: 128ch; }
  }
  .crumb {
    font-family: var(--font-mono);
    font-size: 0.75em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .step-title {
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: var(--font-weight-display, 700);
    margin: 0.3rem 0 0.5rem;
    letter-spacing: var(--tracking-display, -0.02em);
    line-height: 1.15;
  }
  .step-dur {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-muted);
  }
  .step-head { margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: var(--border-default, 2px) solid var(--color-border); }
  .step-foot {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.85em;
    color: var(--color-muted);
  }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar-wrap { display: none; }
  }
</style>
