---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import UserMenu from "../components/auth/UserMenu.astro";
import { withBase } from "../lib/base";

interface Props {
  title?: string;
  description?: string;
  siteName?: string;
  tagline?: string;
  /**
   * Top navigation mode:
   *  - "full": Navbar with logo + UserMenu (default — every page).
   *  - "userMenu": floating UserMenu only, no logo. For the homepage
   *    where the Hero already shows the brand inline.
   *  - "none": no nav at all.
   */
  nav?: "full" | "userMenu" | "none";
  /** Logo URL passed to Navbar (when nav === "full"). */
  logoUrl?: string;
  /**
   * Intrinsic logo aspect ratio (in the image's native units, ratio
   * only). Forwarded to the Navbar's <img> as `width`/`height` so the
   * browser reserves correct box size before the SVG arrives,
   * preventing CLS in the navbar row. Override both for non-square
   * logos.
   */
  logoWidth?: number;
  logoHeight?: number;
  /** Favicon URL injected into <head>. */
  faviconUrl?: string;
  /** Optional social preview image for Open Graph and Twitter cards. */
  ogImageUrl?: string;
  /** Show the site footer ("Built with Handzon" + repo link). */
  showFooter?: boolean;
  /** Footer link URL; defaults to the Handzon repo. */
  repoUrl?: string;
  /** Primary footer credit link (the site owner, e.g. https://render.com).
   *  When set, the footer leads with the site credit and demotes the
   *  Handzon link to a secondary side link. */
  siteUrl?: string;
  /** Primary footer credit label. Defaults to siteName. */
  siteCreditLabel?: string;
  /**
   * Width of the page's content column. Drives the navbar + footer
   * alignment via the --hz-page-max-width CSS custom property so the
   * top/bottom bars sit flush with whatever the page renders. Default
   * "80rem" matches the home grid; reader-style pages can pass a
   * narrower value (e.g. "56rem"). Pass "none" for full-width layouts
   * like the tutorial step (sidebar + main, no centered column).
   */
  pageMaxWidth?: string;
  /**
   * Horizontal padding inside the navbar + footer. Defaults to
   * clamp(1rem, 4vw, 2rem). Use a smaller value (e.g. "1rem") when
   * the page itself sits flush against the viewport edge — tutorial
   * step pages do this to line up with the sidebar.
   */
  pagePaddingX?: string;
}
const {
  title,
  description,
  siteName = "Handzon",
  tagline = "Hands-on tutorials",
  nav = "full",
  logoUrl = "/logo.svg",
  logoWidth = 76,
  logoHeight = 58,
  faviconUrl = "/favicon.svg",
  ogImageUrl,
  showFooter = true,
  repoUrl,
  siteUrl,
  siteCreditLabel,
  // Default to a full-width navbar + footer with a small consistent
  // inset, matching the tutorial step page. Pages with a centred
  // column (home grid, tutorial landing) keep their own content
  // column; the bars stay as site-wide strips.
  pageMaxWidth = "none",
  pagePaddingX = "1rem",
} = Astro.props;
// pageMaxWidth: "none" means no constraint — bars span the full
// viewport width with just the padding.
const resolvedMaxWidth = pageMaxWidth === "none" ? "none" : pageMaxWidth;
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const desc = description ?? tagline;
const socialImageUrl = ogImageUrl ? withBase(ogImageUrl) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase(faviconUrl)} />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {/* Optional consumer-side <head> injections. Forwarded by every
     * page wrapper (Home, TutorialLanding, TutorialStep / TutorialLayout)
     * so scaffolds can preload fonts, attach per-page OG images, add
     * JSON-LD structured data, or wire verification meta without
     * forking BaseLayout. See README for usage. */}
    <slot name="head" />
  </head>
  <body style={`--hz-page-max-width: ${resolvedMaxWidth}; --hz-page-padding-x: ${pagePaddingX}; --hz-nav-height: 3rem;`}>
    {nav === "full" && (
      <Navbar
        logoUrl={logoUrl}
        siteName={siteName}
        logoWidth={logoWidth}
        logoHeight={logoHeight}
      />
    )}
    {nav === "userMenu" && (
      <div class="hz-topbar">
        <UserMenu />
      </div>
    )}
    {/* Wrap the slot in a flex-growing region so the footer hugs the
        bottom of the viewport even when the page content is short. */}
    <div class="hz-page">
      <slot />
    </div>
    {/* Footer content is configurable via siteName/siteCreditLabel/siteUrl/repoUrl. For
        a fully custom footer, a scaffold can pass showFooter={false} and
        render its own markup in the page body. */}
    {showFooter && (
      <Footer
        siteName={siteName}
        siteCreditLabel={siteCreditLabel}
        siteUrl={siteUrl}
        repoUrl={repoUrl}
      />
    )}
    <script>
      // Render any <pre class="mermaid"> blocks emitted by rehype-mermaid,
      // themed to match the active site palette (see lib/mermaid-theme).
      //
      // We capture each block's source synchronously (this module runs before
      // the window `load` event) and render explicitly rather than calling
      // mermaid.run(). mermaid auto-runs on `load` with its default theme, and
      // on a fast load that race can win and mark nodes data-processed before
      // our dynamic import resolves — leaving unthemed diagrams. Rendering each
      // block ourselves from the captured source sidesteps that entirely.
      const mermaidBlocks = Array.from(document.querySelectorAll("pre.mermaid"));
      if (mermaidBlocks.length > 0) {
        const sources = mermaidBlocks.map((el) => el.textContent ?? "");
        Promise.all([
          import("mermaid"),
          import("handzon-core/lib/mermaid-theme.ts"),
        ]).then(async ([{ default: mermaid }, { buildMermaidConfig }]) => {
          mermaid.startOnLoad = false;
          mermaid.initialize(buildMermaidConfig());
          for (let i = 0; i < mermaidBlocks.length; i++) {
            try {
              const { svg } = await mermaid.render(`hz-mermaid-${i}`, sources[i]);
              mermaidBlocks[i].innerHTML = svg;
              mermaidBlocks[i].setAttribute("data-processed", "true");
            } catch (err) {
              console.error("Mermaid render failed", err);
            }
          }
        });
      }
    </script>

    <style is:global>
      /* Sticky-footer layout: body is a flex column at viewport height
       * minimum; the page-content region grows to fill, pushing the
       * footer to the bottom when content is short. */
      html, body {
        min-height: 100dvh;
      }
      body {
        display: flex;
        flex-direction: column;
      }
      .hz-page {
        flex: 1 0 auto;
        display: flex;
        flex-direction: column;
      }
      .hz-page > * {
        flex: 1 0 auto;
      }

      .hz-topbar {
        position: fixed;
        top: 0.75rem;
        right: 0.9rem;
        z-index: 50;
      }
      .hz-topbar:empty {
        display: none;
      }
    </style>
  </body>
</html>
