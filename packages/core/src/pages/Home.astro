---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import TutorialCard from "../components/home/TutorialCard.astro";
import FilterBar from "../components/home/FilterBar.tsx";
import Pagination from "../components/home/Pagination.tsx";
import ResumeRail from "../components/home/ResumeRail.tsx";
import { getTutorials, getStepsForTutorial, sumDurations } from "../lib/content.ts";

interface Props {
  siteName?: string;
  tagline?: string;
  hero?: { title?: string; subtitle?: string };
  logoUrl?: string;
  logoWidth?: number;
  logoHeight?: number;
  faviconUrl?: string;
  repoUrl?: string;
  siteUrl?: string;
  /** Set false to drop the built-in footer and supply your own. */
  showFooter?: boolean;
  showResumeRail?: boolean;
  emptyStateCommand?: string;
  /** Tutorials per page on the grid. */
  pageSize?: number;
}

const {
  siteName = "Handzon",
  tagline = "Hands-on tutorials",
  hero,
  logoUrl,
  logoWidth,
  logoHeight,
  faviconUrl,
  repoUrl,
  siteUrl,
  showFooter = true,
  showResumeRail = true,
  emptyStateCommand = "pnpm handzon:new",
  pageSize = 9,
} = Astro.props;

const tutorials = await getTutorials();
const stepsByTutorial = new Map(
  await Promise.all(
    tutorials.map(async (t) => [t.id, await getStepsForTutorial(t.id)] as const),
  ),
);
const difficulties = ["beginner", "intermediate", "advanced"];
const tags = Array.from(new Set(tutorials.flatMap((t) => t.data.tags))).sort();
const compactTutorials = tutorials.map((t) => ({ slug: t.id, title: t.data.title }));

// Hit counts per facet. Computed server-side over the already-loaded
// tutorials list (no extra IO). Passed to FilterBar as plain Records;
// Maps don't serialize across the SSR/island boundary.
const difficultyCounts: Record<string, number> = {};
const tagCounts: Record<string, number> = {};
for (const t of tutorials) {
  difficultyCounts[t.data.difficulty] = (difficultyCounts[t.data.difficulty] ?? 0) + 1;
  for (const tag of t.data.tags) tagCounts[tag] = (tagCounts[tag] ?? 0) + 1;
}
---
<BaseLayout
  siteName={siteName}
  tagline={tagline}
  logoUrl={logoUrl}
  logoWidth={logoWidth}
  logoHeight={logoHeight}
  faviconUrl={faviconUrl}
  repoUrl={repoUrl}
  siteUrl={siteUrl}
  showFooter={showFooter}
  nav="userMenu"
>
  <slot name="head" slot="head" />
  <div class="home">
    <Hero
      title={hero?.title}
      subtitle={hero?.subtitle}
      logoUrl={logoUrl}
      logoWidth={logoWidth}
      logoHeight={logoHeight}
    />

    {showResumeRail && (
      <ResumeRail client:load tutorials={compactTutorials} />
    )}

    <FilterBar
      client:load
      difficulties={difficulties}
      tags={tags}
      difficultyCounts={difficultyCounts}
      tagCounts={tagCounts}
    />

    <div class="results-status" data-results-status aria-live="polite"></div>

    <section class="grid">
      {tutorials.map((tut) => {
        const steps = stepsByTutorial.get(tut.id) ?? [];
        const dur = tut.data.estimatedDuration ?? sumDurations(steps);
        return <TutorialCard tutorial={tut} duration={dur} stepCount={steps.length} />;
      })}
    </section>

    <Pagination client:load pageSize={pageSize} />

    <div class="empty" data-empty-state hidden>
      <p>No tutorials match the current filters.</p>
    </div>

    {tutorials.length === 0 && (
      <div class="empty">
        <p>
          No tutorials yet. Run <code>{emptyStateCommand}</code> to create your first one.
        </p>
      </div>
    )}
  </div>

  <script>
    // Hydrate per-card progress mini-bars from localStorage. Use a subpath
    // import to avoid pulling the server-only barrel into the client bundle.
    import { getStore } from "../lib/progress/local.ts";
    function refresh() {
      const state = getStore().get();
      // Only the *numerator* (completed-step count) is computed from
      // localStorage. The *denominator* comes from the card's
      // server-rendered `data-step-count` so a learner who's only
      // visited 1 of 4 steps still sees "1/4", not "1/1".
      const completed = new Map<string, number>();
      for (const [key, value] of Object.entries(state.steps)) {
        if (value !== "complete") continue;
        const slug = key.split("/")[0];
        if (!slug) continue;
        completed.set(slug, (completed.get(slug) ?? 0) + 1);
      }
      // SVG ring geometry: r=9 → circumference 2π·9 ≈ 56.5485.
      const R = 9;
      const C = 2 * Math.PI * R;
      document.querySelectorAll<HTMLElement>("[data-tutorial-slug]").forEach((el) => {
        const slug = el.dataset.tutorialSlug!;
        const total = Number(el.dataset.stepCount ?? "0");
        const done = Math.min(completed.get(slug) ?? 0, total);
        if (total === 0 || done === 0) {
          el.innerHTML = "";
          return;
        }
        const pct = done / total;
        const offset = C * (1 - pct);
        el.setAttribute("title", `${done} of ${total} steps complete`);
        el.innerHTML =
          `<span class="ring-label">${done}/${total}</span>` +
          `<svg class="ring" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">` +
            `<circle class="ring-track" cx="12" cy="12" r="${R}"></circle>` +
            `<circle class="ring-fill" cx="12" cy="12" r="${R}" ` +
              `stroke-dasharray="${C.toFixed(2)}" ` +
              `stroke-dashoffset="${offset.toFixed(2)}"></circle>` +
          `</svg>`;
      });
    }
    refresh();
    getStore().subscribe(refresh);
  </script>

  <script>
    // Hydrate cross-learner popularity numbers and the `data-popularity`
    // attribute used by the FilterBar's "Popular" sort. Single fetch on
    // mount; Cache-Control: max-age=60 on the response handles SPA-like
    // navigations. Failures are silent — cards just show no numbers,
    // which is the desired state on Tier 1 anyway.
    import { withBase } from "../lib/base.ts";
    type Stat = { slug: string; started: number; completed: number };
    function fmt(n: number): string {
      if (n < 1000) return String(n);
      if (n < 10_000) return `${(n / 1000).toFixed(1)}k`;
      if (n < 1_000_000) return `${Math.round(n / 1000)}k`;
      return `${(n / 1_000_000).toFixed(1)}M`;
    }
    function popularityScore(stat: Stat): number {
      // Weight completion higher than start. Completed learners are a
      // much stronger signal than visitors who bounced after step 1.
      return stat.completed * 3 + stat.started;
    }
    async function hydrateStats() {
      try {
        const res = await fetch(withBase("/api/tutorials/stats"), { credentials: "same-origin" });
        if (!res.ok) return;
        const data = (await res.json()) as { stats: Stat[] };
        for (const stat of data.stats) {
          const card = document.querySelector<HTMLElement>(
            `[data-card-slug="${CSS.escape(stat.slug)}"]`,
          );
          if (!card) continue;
          card.dataset.popularity = String(popularityScore(stat));
          const slot = card.querySelector<HTMLElement>(
            `[data-tutorial-stats-slug="${CSS.escape(stat.slug)}"]`,
          );
          if (!slot) continue;
          if (stat.started === 0 && stat.completed === 0) continue;
          slot.innerHTML =
            `<span class="stat" title="Unique learners started">▶ ${fmt(stat.started)} started</span>` +
            `<span class="stat-divider">·</span>` +
            `<span class="stat" title="Unique learners completed">✓ ${fmt(stat.completed)} finished</span>`;
        }
        window.dispatchEvent(new CustomEvent("hz:stats-loaded"));
      } catch {
        // ignore
      }
    }
    hydrateStats();
  </script>

  <script>
    // Popularity sort: re-orders cards in place by writing CSS `order`
    // from `data-popularity`. Composes with the existing filter/page
    // hide attributes because order is a flex/grid layout concern, not
    // a visibility concern.
    function applySort(mode: string) {
      const cards = document.querySelectorAll<HTMLElement>("[data-card-slug]");
      if (mode === "popular") {
        const sorted = Array.from(cards).sort((a, b) => {
          return Number(b.dataset.popularity ?? 0) - Number(a.dataset.popularity ?? 0);
        });
        sorted.forEach((card, idx) => {
          card.style.order = String(idx);
        });
      } else {
        cards.forEach((card) => {
          card.style.removeProperty("order");
        });
      }
    }
    function syncFromUrl() {
      const url = new URL(window.location.href);
      applySort(url.searchParams.get("sort") ?? "");
    }
    syncFromUrl();
    window.addEventListener("hz:sort-changed", (e) => {
      applySort((e as CustomEvent<{ sort: string }>).detail.sort);
    });
    window.addEventListener("hz:stats-loaded", syncFromUrl);
  </script>
</BaseLayout>

<style>
  .home {
    /* width: 100% defeats the auto-margin space-absorption that
     * BaseLayout's flex-column body would otherwise apply, so the
     * page actually reaches its max-width at wide viewports. Without
     * this, auto margins eat all the slack and the column collapses
     * to its content width. */
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2rem) 4rem;
  }
  .grid {
    display: grid;
    /* Cap at 3 columns max: the lower-bound of each track is the larger
     * of 280px or one-third of the row (minus the two 1rem gaps). On
     * wide viewports the (100% - 2rem)/3 term wins and forces exactly
     * 3 columns; on narrow viewports 280px wins and the grid wraps to
     * 2 or 1 columns as usual. */
    grid-template-columns: repeat(auto-fill, minmax(max(280px, (100% - 2rem) / 3), 1fr));
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .results-status {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78em;
    color: var(--color-muted);
    min-height: 1em;
  }
  .results-status:empty { display: none; }
  .empty {
    margin: 2rem 0;
    padding: 2rem;
    border: var(--border-default, 2px) solid var(--color-border);
    text-align: center;
    color: var(--color-muted);
  }
</style>

<style is:global>
  /* ---------- Resume rail ---------- */
  /* One coherent link, not a stack of three competing styles. Border
   * lights up on hover; the trailing → is the accent. Everything else
   * sits on a single muted/foreground baseline. */
  .resume-rail {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0.7rem 0.95rem;
    border: 1px solid var(--color-border);
    color: var(--color-fg);
    font-size: 0.95em;
    text-decoration: none;
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .resume-rail:hover {
    border-color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 6%, transparent);
  }
  .rr-prefix {
    font-family: var(--font-mono);
    font-size: 0.78em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .rr-title { font-weight: 600; }
  .rr-step {
    color: var(--color-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rr-arrow {
    margin-left: auto;
    color: var(--color-accent);
    font-family: var(--font-mono);
    transition: transform 0.12s ease;
  }
  .resume-rail:hover .rr-arrow { transform: translateX(3px); }

  /* Filterbar + multi-select popover + pill styles live in
   * packages/core/styles/components/filterbar.css and multiselect.css.
   * Cards hidden by filter and/or pagination — both layers compose
   * via their own data-attribute. */
  [data-filter-hidden],
  [data-page-hidden] {
    display: none !important;
  }

  /* ---------- Pagination ---------- */
  .pagination {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-muted);
  }
  .pg-btn {
    padding: 0.45rem 0.85rem;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-fg);
    font: inherit;
    cursor: pointer;
    transition: border-color 0.12s ease, color 0.12s ease;
  }
  .pg-btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .pg-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .pg-status strong { color: var(--color-fg); }

</style>
