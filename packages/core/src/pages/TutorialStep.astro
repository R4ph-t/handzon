---
import { render } from "astro:content";
import TutorialLayout from "../layouts/TutorialLayout.astro";
import ChatButton from "../components/ai/ChatButton.tsx";
import OpenInAgent from "../components/ai/OpenInAgent.tsx";
import SelectionAsk from "../components/ai/SelectionAsk.tsx";
import StepHelp from "../components/ai/StepHelp.tsx";
import { getStepsForTutorial, getTutorialBySlug, parseStepId, sumDurations } from "../lib/content.ts";
import type { StepEntry, TutorialEntry } from "../lib/content.ts";
import { mdxComponents } from "../lib/mdx-components.ts";
import { buildContext } from "../lib/ai/context.ts";
import { emptyState } from "../lib/progress/types.ts";
import { createTutorialSummary } from "../lib/tutorialSummary.ts";
import type { AiConfig } from "../types/ai.ts";

interface Props {
  tutorial: TutorialEntry;
  steps: StepEntry[];
  currentStep: StepEntry;
  aiDefaults: AiConfig;
  siteName?: string;
  tagline?: string;
  logoUrl?: string;
  logoWidth?: number;
  logoHeight?: number;
  faviconUrl?: string;
  repoUrl?: string;
  siteUrl?: string;
  siteCreditLabel?: string;
  /** Set false to drop the built-in footer and supply your own. */
  showFooter?: boolean;
}

const {
  tutorial,
  steps,
  currentStep,
  aiDefaults,
  siteName,
  tagline,
  logoUrl,
  logoWidth,
  logoHeight,
  faviconUrl,
  repoUrl,
  siteUrl,
  siteCreditLabel,
  showFooter = true,
} = Astro.props;
const { stepSlug } = parseStepId(currentStep.id);
const { Content } = await render(currentStep);

const components = mdxComponents();
const hasCheckpoint = currentStep.body?.includes("<Checkpoint") ?? false;
const hasQuiz = currentStep.body?.includes("<Quiz") ?? false;
const nextTutorial = tutorial.data.nextTutorial
  ? await getTutorialBySlug(tutorial.data.nextTutorial)
  : undefined;
const nextTutorialSteps = nextTutorial ? await getStepsForTutorial(nextTutorial.id) : [];
const nextTutorialSummary = nextTutorial
  ? createTutorialSummary(nextTutorial, sumDurations(nextTutorialSteps))
  : undefined;

const aiConfig: AiConfig = { ...aiDefaults, ...(tutorial.data.ai ?? {}) };
const initialContext = buildContext({
  tutorial,
  steps,
  currentStep,
  progress: emptyState(),
  references: [],
  includeFutureSteps: aiConfig.includeFutureSteps,
});
---
<TutorialLayout
  tutorial={tutorial}
  steps={steps}
  currentStep={currentStep}
  currentStepSlug={stepSlug}
  hasCheckpoint={hasCheckpoint}
  hasQuiz={hasQuiz}
  siteName={siteName}
  tagline={tagline}
  logoUrl={logoUrl}
  logoWidth={logoWidth}
  logoHeight={logoHeight}
  faviconUrl={faviconUrl}
  repoUrl={repoUrl}
  siteUrl={siteUrl}
  siteCreditLabel={siteCreditLabel}
  nextTutorial={nextTutorialSummary}
  showFooter={showFooter}
>
  <slot name="head" slot="head" />
  <Content components={components} />
  {aiConfig.enabled && aiConfig.autoStepHelp && (
    <StepHelp client:visible stepTitle={currentStep.data.title} />
  )}
  <OpenInAgent client:visible />

  {aiConfig.enabled && (
    <>
      <ChatButton client:idle config={aiConfig} context={initialContext} />
      <SelectionAsk client:idle />
    </>
  )}
</TutorialLayout>
