---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { withBase } from "../lib/base";
import Embed from "./mdx/Embed.astro";

type StepHeroMedia =
  | {
      kind: "image";
      src: string | ImageMetadata;
      alt: string;
      caption?: string;
    }
  | {
      kind: "video";
      src: string;
      title: string;
      aspect?: string;
      type?: "iframe" | "video";
      caption?: string;
    };

interface Props {
  media: StepHeroMedia;
}

const { media } = Astro.props;

---
<figure class="step-hero-media">
  {media.kind === "video" ? (
    <Embed
      src={media.src}
      title={media.title}
      aspect={media.aspect}
      type={media.type}
    />
  ) : typeof media.src !== "string" ? (
    <Image
      src={media.src}
      alt={media.alt}
      class="step-hero-image"
      widths={[720, 960, 1200, 1440]}
      sizes="(min-width: 900px) 720px, 100vw"
    />
  ) : (
    <img
      src={withBase(media.src)}
      alt={media.alt}
      class="step-hero-image"
      loading="eager"
    />
  )}
  {media.caption && <figcaption>{media.caption}</figcaption>}
</figure>

<style>
  .step-hero-media {
    margin: 0 0 2rem;
  }
  .step-hero-media :global(.embed) {
    margin: 0;
  }
  .step-hero-image {
    display: block;
    width: 100%;
    height: auto;
    border: var(--border-default, 2px) solid var(--color-border);
    background: var(--color-surface);
  }
  figcaption {
    margin-top: 0.65rem;
    color: var(--color-muted);
    font-size: 0.85em;
    line-height: 1.5;
  }
</style>
