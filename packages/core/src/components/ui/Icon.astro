---
import { dynamicIconImports } from "lucide-react/dynamic";
import { siDiscord, siGithub, siGitlab, siX, siYoutube } from "simple-icons";

interface Props {
  /** A lucide icon name in kebab-case, e.g. "lightbulb", "target", "brain". */
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 16, strokeWidth, class: className } = Astro.props;

/**
 * Lazily load only the requested icon and server-render it to inline SVG.
 * No client JS is shipped — the lucide React component is rendered statically
 * at build/SSR time. Unknown names render nothing.
 */
const imports = dynamicIconImports as Record<
  string,
  () => Promise<{ default: (props: Record<string, unknown>) => unknown }>
>;
const loader = imports[name];
const IconComponent = loader ? (await loader()).default : null;

/**
 * Brand glyphs lucide no longer ships (e.g. "github") come from simple-icons.
 * These are single filled paths on a 24x24 grid, so they render as a plain
 * <svg> rather than a lucide stroke icon.
 */
const brandIcons: Record<string, { path: string }> = {
  github: siGithub,
  gitlab: siGitlab,
  discord: siDiscord,
  youtube: siYoutube,
  x: siX,
  twitter: siX,
};
const brand = IconComponent ? null : (brandIcons[name] ?? null);
---
{
  IconComponent ? (
    <IconComponent
      size={size}
      strokeWidth={strokeWidth}
      className={className}
      aria-hidden="true"
    />
  ) : brand ? (
    <svg
      class={className}
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="currentColor"
      aria-hidden="true"
      set:html={`<path d="${brand.path}"/>`}
    />
  ) : null
}
