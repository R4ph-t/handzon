---
interface Props {
  title?: string;
  subtitle?: string;
  /**
   * Brand mark shown left of the headline. Defaults to `/logo.svg`
   * (the scaffold ships a starter at `public/logo.svg`). Pass `""`
   * to hide the logo entirely.
   */
  logoUrl?: string;
  /**
   * Intrinsic aspect ratio of the logo, supplied as the SVG/image's
   * native width and height (any unit — only the ratio matters). The
   * browser uses these to reserve the correct box size before the
   * image loads, preventing CLS as surrounding text reflows. Defaults
   * track the shipped `public/logo.svg` (`viewBox="10 20 76 58"`).
   * Override both when swapping in a non-square logo.
   */
  logoWidth?: number;
  logoHeight?: number;
}
const {
  title = "Handzon.",
  subtitle = "Step-by-step tutorials.",
  logoUrl = "/logo.svg",
  logoWidth = 76,
  logoHeight = 58,
} = Astro.props;
---
<header class="hero">
  <h1 class="hero-headline">
    {logoUrl && (
      <img
        class="hero-logo"
        src={logoUrl}
        alt=""
        aria-hidden="true"
        width={logoWidth}
        height={logoHeight}
      />
    )}
    <span>{title}</span>
  </h1>
  <p>{subtitle}</p>
</header>

<style>
  .hero {
    padding: 4rem 0 2rem;
    border-bottom: var(--border-default, 2px) solid var(--color-border);
  }
  .hero-headline {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.2vw, 1rem);
    margin: 0 0 0.75rem;
    font-family: var(--font-display, var(--font-sans));
    font-size: var(--text-display, clamp(2.25rem, 5vw, 3.75rem));
    font-weight: var(--font-weight-display, 700);
    letter-spacing: var(--tracking-display, -0.025em);
    line-height: 1.05;
  }
  /* Logo height tracks the heading's cap-height (~0.72em of the
   * font-size) so the brand mark visually matches the "H" glyph. The
   * SVG's viewBox has been tightened to remove padding, so the box
   * dimensions are the visible mark. */
  .hero-logo {
    height: 0.72em;
    width: auto;
    display: block;
    flex-shrink: 0;
  }
  .hero p {
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: min(100%, 86ch);
    margin: 0;
    text-wrap: pretty;
  }
</style>
