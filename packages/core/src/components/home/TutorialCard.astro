---
import type { TutorialEntry } from "../../lib/content";

interface Props {
  tutorial: TutorialEntry;
  duration?: string;
}
const { tutorial, duration } = Astro.props;
const data = tutorial.data;
const slug = tutorial.id;
---
<article
  class="card"
  data-difficulty={data.difficulty}
  data-tags={data.tags.join(",")}
  data-search={`${data.title} ${data.description} ${data.tags.join(" ")}`.toLowerCase()}
  data-card-slug={slug}
  data-popularity="0"
>
  <a href={`/${slug}`} class="card-link">
    <div class="card-body">
      <h3>{data.title}</h3>
      <p>{data.description}</p>
      <div class="badges">
        <span class={`badge badge-${data.difficulty}`}>{data.difficulty}</span>
        {duration && (
          <span class="badge badge-neutral">
            <svg
              viewBox="0 0 24 24"
              width="11"
              height="11"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 7 12 12 15 14" />
            </svg>
            {duration}
          </span>
        )}
      </div>
      {data.tags.length > 0 && (
        <div class="tags">
          {data.tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
      )}
      <div
        class="card-stats"
        data-tutorial-stats-slug={slug}
        aria-hidden="true"
      ></div>
      <div class="card-progress" data-tutorial-slug={slug}></div>
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    display: flex;
    transition: border-color 0.12s ease, transform 0.12s ease;
  }
  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .card-link {
    color: var(--color-fg);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .card-body {
    padding: 1.1rem 1.2rem 1.2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* Metadata row: difficulty + duration with a divider beneath it.
   * `margin-top: auto` pins this row (and everything below it — tags,
   * stats, progress) to the bottom of the card so all cards in the
   * grid share the same bottom alignment regardless of how short the
   * description is. */
  .badges {
    display: flex;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
  .badge svg {
    flex-shrink: 0;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.18rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }
  .badge-beginner::before,
  .badge-intermediate::before,
  .badge-advanced::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }
  .badge-beginner { color: var(--color-success); }
  .badge-intermediate { color: var(--color-warn); }
  .badge-advanced { color: var(--color-danger); }

  h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92em;
    line-height: 1.5;
    /* Clamp to 3 lines so cards stay the same height regardless of
     * description length. Keeps the grid visually consistent. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tags — quiet, hash-prefixed. Pinned toward the bottom via
   * margin-top: auto so cards in the grid stay the same height when
   * descriptions vary. */
  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.85rem;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.7em;
    color: var(--color-muted);
  }

  .card-progress:not(:empty) { padding-top: 0.5rem; }

  /* Cross-learner popularity, hydrated from /api/tutorials/stats.
   * Hidden until the script populates content so the card height
   * stays stable on first paint and gracefully degrades on Tier 1
   * (no DB → no numbers → no row). */
  .card-stats:empty { display: none; }
  .card-stats {
    margin-top: 0.6rem;
    display: flex;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7em;
    color: var(--color-muted);
  }
  .card-stats .stat {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .card-stats .stat-divider {
    color: var(--color-border);
  }
</style>
