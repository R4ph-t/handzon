---
import { Image } from "astro:assets";
import { withBase } from "../../lib/base";
import type { TutorialEntry } from "../../lib/content";
import { getDefaultCoverMeta } from "../../lib/defaultCover";

interface Props {
  tutorial: TutorialEntry;
  duration?: string;
  /** Total number of steps in this tutorial. Used as the denominator
   *  for the per-card progress bar — has to come from the server-side
   *  content collection because localStorage only holds states for the
   *  steps the user has visited (so a fresh learner who completed 1 of
   *  4 steps would otherwise see 1/1). */
  stepCount: number;
}
const { tutorial, duration, stepCount } = Astro.props;
const data = tutorial.data;
const slug = tutorial.id;
const iconText = typeof data.icon === "string" ? data.icon : undefined;
const iconImage =
  data.icon && typeof data.icon !== "string" ? data.icon : undefined;
const defaultCover = getDefaultCoverMeta({
  slug,
  title: data.title,
  difficulty: data.difficulty,
  tags: data.tags,
  icon: data.icon,
});
---

<article
  class="card"
  data-difficulty={data.difficulty}
  data-tags={data.tags.join(",")}
  data-search={`${data.title} ${data.description} ${data.tags.join(" ")}`.toLowerCase()}
  data-card-slug={slug}
  data-popularity="0"
>
  <button
    type="button"
    class="card-fav"
    data-fav-slug={slug}
    aria-pressed="false"
    aria-label={`Add ${data.title} to favorites`}
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M11.48 3.5a.59.59 0 0 1 1.04 0l2.38 4.82a.59.59 0 0 0 .44.32l5.32.77a.59.59 0 0 1 .33 1l-3.85 3.75a.59.59 0 0 0-.17.52l.91 5.3a.59.59 0 0 1-.86.62l-4.76-2.5a.59.59 0 0 0-.55 0l-4.76 2.5a.59.59 0 0 1-.86-.62l.91-5.3a.59.59 0 0 0-.17-.52L3.01 10.4a.59.59 0 0 1 .33-1l5.32-.77a.59.59 0 0 0 .44-.32l2.38-4.82Z"
      />
    </svg>
    <span class="sr-only">Favorite</span>
  </button>
  <a href={withBase(`/${slug}`)} class="card-link">
    <div class="card-media">
      {
        data.cover ? (
          <Image
            src={data.cover}
            alt=""
            class="card-cover"
            loading="lazy"
            widths={[360, 540, 720]}
            sizes="(min-width: 960px) 33vw, (min-width: 640px) 50vw, 100vw"
          />
        ) : (
          <div
            class={`card-cover-fallback pattern-${defaultCover.pattern} scale-${defaultCover.scale} glow-${defaultCover.glow} variant-${defaultCover.variant} difficulty-${defaultCover.difficulty}`}
            aria-hidden="true"
          >
            <span class="fallback-keywords">
              {defaultCover.keywords.map((keyword) => (
                <span>{keyword}</span>
              ))}
            </span>
            {defaultCover.icon ? (
              <span class="fallback-watermark">
                <svg
                  viewBox="0 0 24 24"
                  width="120"
                  height="120"
                  aria-hidden="true"
                >
                  <path d={defaultCover.icon.path} />
                </svg>
              </span>
            ) : null}
          </div>
        )
      }
    </div>
    <div class="card-body">
      <div class="card-title-row">
        {
          iconImage && (
            <Image
              src={iconImage}
              alt=""
              class="card-icon card-icon-image"
              loading="lazy"
              width={32}
              height={32}
            />
          )
        }
        {
          iconText && (
            <span class="card-icon card-icon-text" aria-hidden="true">
              {iconText}
            </span>
          )
        }
        <h3>{data.title}</h3>
      </div>
      <p>{data.description}</p>
      <div class="badges">
        <span class={`badge badge-${data.difficulty}`}>{data.difficulty}</span>
        {
          duration && (
            <span class="badge badge-neutral">
              <svg
                viewBox="0 0 24 24"
                width="11"
                height="11"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 7 12 12 15 14" />
              </svg>
              {duration}
            </span>
          )
        }
        <span
          class="card-progress"
          data-tutorial-slug={slug}
          data-step-count={stepCount}></span>
      </div>
      {
        data.tags.length > 0 && (
          <div class="tags">
            {data.tags.map((tag: string) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )
      }
      <div
        class="card-stats"
        data-tutorial-stats-slug={slug}
        aria-hidden="true"
      >
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    display: flex;
    position: relative;
    transition:
      border-color 0.12s ease,
      transform 0.12s ease;
  }
  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .card-link {
    color: var(--color-fg);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .card-fav {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    z-index: 5;
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color 0.12s ease,
      transform 0.12s ease;
  }
  .card-fav:hover,
  .card-fav:focus-visible {
    color: var(--color-fg);
    outline: none;
    transform: scale(1.04);
  }
  .card-fav[aria-pressed="true"] {
    color: #fff;
  }
  .card-fav[aria-pressed="true"] svg {
    fill: currentColor;
  }
  .card-media {
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--color-accent) 10%, transparent),
      var(--color-surface)
    );
    overflow: hidden;
  }
  .card-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.92) contrast(1.05);
    transition:
      transform 0.18s ease,
      filter 0.18s ease;
  }
  .card-cover-fallback {
    --cover-accent: var(--color-accent);
    --cover-glow-x: 28%;
    --cover-glow-y: 76%;
    --cover-grid-size: 1rem;
    --cover-dot-size: 0.9rem;
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    padding: 1rem;
    overflow: hidden;
    background:
      radial-gradient(
        circle at var(--cover-glow-x) var(--cover-glow-y),
        color-mix(in oklab, var(--cover-accent) 22%, transparent),
        transparent 34%
      ),
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--cover-accent) 10%, var(--color-bg)),
        var(--color-surface)
      );
    transition:
      transform 0.18s ease,
      filter 0.18s ease;
  }
  .card-cover-fallback::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .card-cover-fallback::before {
    opacity: 0.24;
  }
  .difficulty-beginner {
    --cover-accent: var(--color-success);
  }
  .difficulty-intermediate {
    --cover-accent: var(--color-warn);
  }
  .difficulty-advanced {
    --cover-accent: var(--color-danger);
  }
  .glow-1 {
    --cover-glow-x: 28%;
    --cover-glow-y: 76%;
  }
  .glow-2 {
    --cover-glow-x: 28%;
    --cover-glow-y: 76%;
  }
  .glow-3 {
    --cover-glow-x: 28%;
    --cover-glow-y: 76%;
  }
  .card-cover-fallback.variant-1 {
    --cover-glow-x: 74%;
    --cover-glow-y: 28%;
  }
  .card-cover-fallback.variant-2 {
    --cover-glow-x: 74%;
    --cover-glow-y: 76%;
  }
  .card-cover-fallback.variant-3 {
    --cover-glow-x: 28%;
    --cover-glow-y: 28%;
  }
  .scale-1 {
    --cover-grid-size: 1.45rem;
    --cover-dot-size: 1.15rem;
  }
  .scale-2 {
    --cover-grid-size: 0.72rem;
    --cover-dot-size: 0.62rem;
  }
  .pattern-grid::before {
    background-image:
      linear-gradient(
        color-mix(in oklab, var(--cover-accent) 16%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in oklab, var(--cover-accent) 16%, transparent) 1px,
        transparent 1px
      );
    background-size: var(--cover-grid-size) var(--cover-grid-size);
  }
  .pattern-dots::before {
    background-image: radial-gradient(
      circle,
      color-mix(in oklab, var(--cover-accent) 18%, transparent) 1px,
      transparent 1.5px
    );
    background-size: var(--cover-dot-size) var(--cover-dot-size);
  }
  .fallback-keywords,
  .fallback-motif {
    position: relative;
    z-index: 3;
  }
  .fallback-keywords {
    position: absolute;
    inset: auto auto 1.05rem 1rem;
    max-width: 58%;
    display: grid;
    gap: 0.15rem;
    justify-items: start;
    color: color-mix(in oklab, var(--cover-accent) 58%, transparent);
    font-family: var(--font-mono);
    font-size: clamp(1.05rem, 4.6vw, 2.1rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 0.9;
    opacity: 0.42;
    text-transform: uppercase;
  }
  .fallback-watermark {
    position: absolute;
    right: -1.35rem;
    bottom: -2.15rem;
    z-index: 1;
    color: var(--cover-accent);
    opacity: 0.16;
    transform: rotate(-8deg);
  }
  .fallback-watermark svg {
    display: block;
    width: clamp(10.5rem, 58%, 14rem);
    height: auto;
    fill: currentColor;
  }
  .variant-1 .fallback-watermark {
    left: -1.45rem;
    right: auto;
    bottom: -2.15rem;
    transform: rotate(7deg);
  }
  .variant-2 .fallback-watermark {
    left: -1.4rem;
    right: auto;
    top: -2.2rem;
    bottom: auto;
    transform: rotate(-10deg);
  }
  .variant-3 .fallback-watermark {
    right: -1.45rem;
    bottom: -2.2rem;
    transform: rotate(9deg);
  }
  .fallback-keywords span:nth-child(2) {
    margin-left: 1.4rem;
  }
  .fallback-keywords span:nth-child(3) {
    margin-left: 0.55rem;
  }
  .fallback-keywords span {
    max-width: 100%;
    overflow: hidden;
    text-overflow: clip;
    white-space: nowrap;
  }
  .variant-1 .fallback-keywords {
    inset: 2.9rem 1rem auto auto;
    justify-items: end;
  }
  .variant-2 .fallback-keywords {
    inset: auto 1rem 1rem auto;
    justify-items: end;
  }
  .variant-3 .fallback-keywords {
    inset: 3rem auto auto 1rem;
  }
  .card:hover .card-cover,
  .card:hover .card-cover-fallback {
    transform: scale(1.025);
    filter: saturate(1) contrast(1.08);
  }
  .card-body {
    padding: 1.1rem 1.2rem 1.2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card-title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin-bottom: 0.5rem;
  }
  .card-icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .card-icon-image {
    object-fit: cover;
    display: block;
  }
  .card-icon-text {
    display: inline-grid;
    place-items: center;
    font-size: 1rem;
    line-height: 1;
  }

  /* Metadata row: difficulty + duration with a divider beneath it.
   * `margin-top: auto` pins this row (and everything below it — tags,
   * stats, progress) to the bottom of the card so all cards in the
   * grid share the same bottom alignment regardless of how short the
   * description is. */
  .badges {
    display: flex;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
  .badge svg {
    flex-shrink: 0;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.18rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }
  .badge-beginner::before,
  .badge-intermediate::before,
  .badge-advanced::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }
  .badge-beginner {
    color: var(--color-success);
  }
  .badge-intermediate {
    color: var(--color-warn);
  }
  .badge-advanced {
    color: var(--color-danger);
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92em;
    line-height: 1.5;
    /* Clamp to 3 lines so cards stay the same height regardless of
     * description length. Keeps the grid visually consistent. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tags — quiet, hash-prefixed. Pinned toward the bottom via
   * margin-top: auto so cards in the grid stay the same height when
   * descriptions vary. */
  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.85rem;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.7em;
    color: var(--color-muted);
  }

  /* Per-card completion ring, hydrated by the home-page script.
   * Sits inside the `.badges` row, pushed to the right edge so it
   * lines up with the level + duration chips on the same baseline. */
  .card-progress {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68em;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .card-progress:empty {
    display: none;
  }
  /* The ring + label live inside `.card-progress` but are injected
   * via innerHTML at runtime, so Astro's scope hash doesn't apply to
   * them. Use :global() so the rules still match. */
  .card-progress :global(.ring) {
    /* Start the fill at 12 o'clock. */
    transform: rotate(-90deg);
    flex-shrink: 0;
  }
  .card-progress :global(.ring-track) {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 2.5;
  }
  .card-progress :global(.ring-fill) {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.3s ease;
  }
  .card-progress :global(.ring-label) {
    color: var(--color-accent);
  }

  /* Cross-learner popularity, hydrated from /api/tutorials/stats.
   * Hidden until the script populates content so the card height
   * stays stable on first paint and gracefully degrades on Tier 1
   * (no DB → no numbers → no row). */
  .card-stats:empty {
    display: none;
  }
  .card-stats {
    margin-top: 0.6rem;
    display: flex;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7em;
    color: var(--color-muted);
  }
  .card-stats .stat {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .card-stats .stat-divider {
    color: var(--color-border);
  }
</style>
