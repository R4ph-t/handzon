---
/**
 * Astro wrapper around the React UserMenu island. Auth state is
 * fetched on the client (see UserMenu.tsx), so this component works
 * the same on prerendered pages and SSR routes — no
 * `Astro.request.headers` access at render time, no warning when a
 * prerendered route happens to include BaseLayout.
 */
import UserMenuIsland from "./UserMenu.tsx";
---
<UserMenuIsland client:only="react" />

<style is:global>
  .user-menu {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8em;
  }
  .um-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    display: inline-block;
    object-fit: cover;
    flex-shrink: 0;
  }
  .um-avatar-fallback {
    background: color-mix(in oklab, var(--color-accent) 15%, var(--color-bg));
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.75em;
    display: inline-grid;
    place-items: center;
  }
  .um-name {
    color: var(--color-fg);
    max-width: 12ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .user-menu form { display: inline-flex; }
  .um-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    background: transparent;
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .um-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .um-btn-icon {
    padding: 0.3rem 0.45rem;
  }
  .um-gh {
    flex-shrink: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
