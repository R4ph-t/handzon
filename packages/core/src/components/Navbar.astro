---
/**
 * Site-wide top bar. Rendered by BaseLayout on every page except the
 * homepage (the homepage's Hero contains the brand mark inline).
 *
 * Layout: logo left, UserMenu right. The logo links back to the
 * homepage. Sticky so it stays available as users scroll long
 * tutorial steps.
 */
import UserMenu from "./auth/UserMenu.astro";

interface Props {
  logoUrl?: string;
  siteName?: string;
  /**
   * Intrinsic aspect ratio of the logo (in the image's native units —
   * only the ratio matters). Forwarded to the <img> element's
   * `width`/`height` attributes so the browser reserves the correct
   * box before the SVG loads, preventing CLS in the navbar row.
   * Defaults track the shipped `public/logo.svg`. Override both when
   * the consumer swaps in a non-square logo.
   */
  logoWidth?: number;
  logoHeight?: number;
}

const {
  logoUrl = "/logo.svg",
  siteName = "Handzon",
  logoWidth = 76,
  logoHeight = 58,
} = Astro.props;
---
<header class="hz-nav">
  <div class="hz-nav-inner">
    {logoUrl && (
      <a href="/" class="hz-nav-brand" aria-label={`${siteName} home`}>
        <img
          src={logoUrl}
          alt={siteName}
          class="hz-nav-logo"
          width={logoWidth}
          height={logoHeight}
        />
      </a>
    )}
    <div class="hz-nav-actions">
      <UserMenu />
    </div>
  </div>
</header>

<style is:global>
  .hz-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in oklab, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }
  .hz-nav-inner {
    /* Align with the current page's content column. Each page sets
     * --hz-page-max-width + --hz-page-padding-x via BaseLayout so the
     * logo lines up with whatever's directly below it: home grid
     * (80rem, 2rem), tutorial landing (56rem, 3rem), tutorial step
     * (full width, 1rem to match the sidebar). */
    max-width: var(--hz-page-max-width, 80rem);
    margin: 0 auto;
    padding: 0.75rem var(--hz-page-padding-x, clamp(1rem, 4vw, 2rem));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .hz-nav-brand {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    opacity: 0.92;
    transition: opacity 0.12s ease;
  }
  .hz-nav-brand:hover { opacity: 1; }
  .hz-nav-logo {
    display: block;
    height: 1.4rem;
    width: auto;
  }
  .hz-nav-actions {
    display: flex;
    align-items: center;
    margin-left: auto;
  }
</style>
