---
// Wraps an ordered list of <Step> items.
---
<ol class="steps"><slot /></ol>

<style is:global>
  .steps {
    counter-reset: step;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: grid;
    gap: 0.6rem;
  }
  .steps li.step {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 0.85rem;
    align-items: baseline;
    padding: 0.6rem 0.85rem;
    border: var(--border-default, 2px) solid var(--color-border);
    background: var(--color-surface);
  }
  .steps li.step::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.85em;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }
  .steps li.step > * {
    margin: 0;
  }
  .steps li.step strong {
    display: block;
    margin-bottom: 0.15rem;
  }

  /* Nested steps: the parent keeps its box; sub-steps read as a divided
     sub-list — a stroke separates them from the parent text, and a thin
     rule sits between each. "1.1"-style numbering joins each scope. */
  .steps .steps {
    margin-top: 0.8rem;
    padding-top: 0.8rem;
    gap: 0;
    border-top: var(--border-default, 1px) solid var(--color-border);
  }
  .steps .steps li.step {
    border: none;
    border-bottom: var(--border-default, 1px) solid var(--color-border);
    background: none;
    padding: 0.55rem 0;
    grid-template-columns: 2rem 1fr;
    gap: 0.6rem;
  }
  .steps .steps li.step:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .steps .steps li.step::before {
    content: counters(step, ".");
  }
</style>
