---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { withBase } from "../../lib/base";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  caption?: string;
  width?: string | number;
}

const { src, alt, caption, width } = Astro.props;

/**
 * Co-located tutorial assets, globbed from the consuming project's root.
 * The leading-slash pattern resolves against the consumer's Vite root at
 * build time (not this file's location in node_modules), so authors can
 * write `src="./assets/x.png"` and get an optimized <Image> without an
 * import — the same resolution `heroMedia` frontmatter gets via `image()`.
 */
const assetModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/**/assets/**/*.{png,jpg,jpeg,gif,webp,avif,svg}",
);

const isExternal = (path: string) => /^([a-z][a-z0-9+.-]*:|\/\/)/i.test(path);

let resolved: ImageMetadata | undefined;
if (typeof src !== "string") {
  resolved = src;
} else if (!isExternal(src)) {
  // Normalize "./assets/x.png", "../assets/x.png", "/assets/x.png" to a tail
  // and match the globbed key that ends with it.
  const needle = src.replace(/^(?:\.\.?\/)+/, "").replace(/^\//, "");
  const key = Object.keys(assetModules).find(
    (k) => k === `/${needle}` || k.endsWith(`/${needle}`),
  );
  if (key) resolved = (await assetModules[key]()).default;
}

const figureStyle =
  width != null ? `max-width: ${typeof width === "number" ? `${width}px` : width};` : undefined;
---

<figure class="figure" style={figureStyle}>
  {resolved ? (
    <Image
      src={resolved}
      alt={alt}
      class="figure-image"
      widths={[480, 720, 960, 1200]}
      sizes="(min-width: 768px) 720px, 100vw"
    />
  ) : (
    <img src={withBase(src as string)} alt={alt} class="figure-image" loading="lazy" />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 1.5rem auto;
  }
  .figure-image {
    display: block;
    width: 100%;
    height: auto;
    border: var(--border-default, 2px) solid var(--color-border);
    background: var(--color-surface);
    border-radius: 0;
  }
  figcaption {
    margin-top: 0.6rem;
    color: var(--color-muted);
    font-size: 0.85em;
    line-height: 1.5;
    text-align: center;
  }
</style>
