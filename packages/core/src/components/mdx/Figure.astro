---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { withBase } from "../../lib/base";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  caption?: string;
  width?: string | number;
}

const { src, alt, caption, width } = Astro.props;
const figureStyle =
  width != null ? `max-width: ${typeof width === "number" ? `${width}px` : width};` : undefined;
---

<figure class="figure" style={figureStyle}>
  {typeof src !== "string" ? (
    <Image
      src={src}
      alt={alt}
      class="figure-image"
      widths={[480, 720, 960, 1200]}
      sizes="(min-width: 768px) 720px, 100vw"
    />
  ) : (
    <img src={withBase(src)} alt={alt} class="figure-image" loading="lazy" />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 1.5rem auto;
  }
  .figure-image {
    display: block;
    width: 100%;
    height: auto;
    border: var(--border-default, 2px) solid var(--color-border);
    background: var(--color-surface);
    border-radius: 0;
  }
  figcaption {
    margin-top: 0.6rem;
    color: var(--color-muted);
    font-size: 0.85em;
    line-height: 1.5;
    text-align: center;
  }
</style>
