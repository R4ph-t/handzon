---
import Icon from "../ui/Icon.astro";

interface Props {
  title?: string;
  items: string[];
  /** A lucide icon name (kebab-case) shown beside the title. "none" hides the
   * default checkmark; omit to keep it. */
  icon?: string;
}
const { title = "What you learned", items, icon } = Astro.props;
const customIcon = icon && icon !== "none" ? icon : undefined;
const showDefaultIcon = icon == null;
---
<section class="recap">
  <h3 class="recap-title">
    {showDefaultIcon && (
      <svg class="recap-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    )}
    {customIcon && <Icon name={customIcon} size={14} strokeWidth={2.5} class="recap-icon" />}
    <span>{title}</span>
  </h3>
  <ul class="recap-items">
    {items.map((item) => (
      <li>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .recap {
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: var(--border-default) solid var(--color-border);
    border-left: var(--border-thick) solid var(--color-accent);
    border-radius: 0;
  }
  .recap-title {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .recap-icon { color: var(--color-accent); flex-shrink: 0; }
  .recap-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .recap-items li {
    display: grid;
    grid-template-columns: 1.1rem 1fr;
    gap: 0.55rem;
    align-items: start;
    margin: 0;
  }
  .recap-items li :global(svg) {
    color: var(--color-accent);
    margin-top: 0.25em;
  }
</style>
