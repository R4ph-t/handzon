---
import Icon from "../ui/Icon.astro";

type ButtonVariant = "primary" | "secondary" | "ghost";
type ButtonColor = "accent" | "info" | "success" | "warn" | "danger";
type ButtonSize = "sm" | "md";
type IconPosition = "left" | "right";

interface Props {
  href?: string;
  variant?: ButtonVariant;
  color?: ButtonColor;
  size?: ButtonSize;
  /** A lucide icon name in kebab-case, e.g. "download", "external-link". */
  icon?: string;
  iconPosition?: IconPosition;
  external?: boolean;
  download?: boolean;
  label?: string;
}

const {
  href,
  variant = "primary",
  color = "accent",
  size = "md",
  icon,
  iconPosition,
  external,
  download,
  label,
} = Astro.props;

const colorVar = {
  accent: "var(--color-accent)",
  info: "var(--color-info)",
  success: "var(--color-success)",
  warn: "var(--color-warn)",
  danger: "var(--color-danger)",
}[color];

// Foreground for filled (primary) buttons. Accent defers to the theme's
// paired token; semantic colors use a dark ink that reads on their lighter
// tones across both light and dark themes.
const filledFg = color === "accent" ? "var(--color-accent-fg)" : "oklch(16% 0 0)";

const isExternal = external ?? (href ? /^https?:\/\//.test(href) : false);

// Trailing icons (outbound link, forward arrow) read better on the right.
const trailingIcons = new Set(["external-link", "arrow-right", "arrow-up-right"]);
const resolvedIconPosition: IconPosition =
  iconPosition ?? (icon && trailingIcons.has(icon) ? "right" : "left");

const iconSize = size === "sm" ? 14 : 16;

const Tag = href ? "a" : "button";
const linkRel = isExternal ? "noopener noreferrer" : undefined;
const linkTarget = isExternal ? "_blank" : undefined;
---

<Tag
  class="hz-button"
  data-variant={variant}
  data-size={size}
  href={href}
  type={href ? undefined : "button"}
  download={download ? true : undefined}
  target={linkTarget}
  rel={linkRel}
  style={`--btn-color: ${colorVar}; --btn-fg: ${filledFg};`}
>
  {icon && resolvedIconPosition === "left" && <Icon name={icon} size={iconSize} class="hz-button-icon" />}
  <span class="hz-button-label"><slot>{label}</slot></span>
  {icon && resolvedIconPosition === "right" && <Icon name={icon} size={iconSize} class="hz-button-icon" />}
</Tag>

<style>
  .hz-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem;
    font-family: var(--font-sans);
    font-size: 0.92em;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    border: var(--border-default) solid transparent;
    border-radius: var(--radius-sm);
    transition:
      transform 0.08s ease,
      box-shadow 0.08s ease,
      background 0.12s ease,
      color 0.12s ease;
  }

  .hz-button[data-size="sm"] {
    padding: 0.35rem 0.7rem;
    font-size: 0.82em;
    gap: 0.35rem;
  }

  .hz-button:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-raised);
  }

  .hz-button:active {
    transform: translate(0, 0);
    box-shadow: var(--shadow-press);
  }

  .hz-button-icon {
    flex-shrink: 0;
  }

  /* Filled */
  .hz-button[data-variant="primary"] {
    background: var(--btn-color);
    color: var(--btn-fg);
    border-color: var(--btn-color);
  }
  .hz-button[data-variant="primary"]:hover {
    background: color-mix(in oklab, var(--btn-color) 88%, var(--color-fg));
    color: var(--btn-fg);
  }

  /* Outline */
  .hz-button[data-variant="secondary"] {
    background: var(--color-bg);
    color: var(--btn-color);
    border-color: var(--btn-color);
  }
  .hz-button[data-variant="secondary"]:hover {
    background: color-mix(in oklab, var(--btn-color) 12%, var(--color-bg));
    color: var(--btn-color);
  }

  /* Text only */
  .hz-button[data-variant="ghost"] {
    background: none;
    color: var(--btn-color);
    border-color: transparent;
    padding-left: 0.35rem;
    padding-right: 0.35rem;
  }
  .hz-button[data-variant="ghost"]:hover {
    background: color-mix(in oklab, var(--btn-color) 12%, var(--color-bg));
    color: var(--btn-color);
    box-shadow: none;
    transform: none;
  }
</style>
