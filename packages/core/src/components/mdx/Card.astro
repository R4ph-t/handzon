---
import Icon from "../ui/Icon.astro";

interface Props {
  title?: string;
  href?: string;
  /** A lucide icon name in kebab-case, e.g. "rocket", "book-open". */
  icon?: string;
  external?: boolean;
}

const { title, href, icon, external } = Astro.props;

const isExternal = external ?? (href ? /^https?:\/\//.test(href) : false);
const Tag = href ? "a" : "div";
const linkRel = isExternal ? "noopener noreferrer" : undefined;
const linkTarget = isExternal ? "_blank" : undefined;
---

<Tag
  class="hz-card"
  data-linked={href ? "true" : undefined}
  href={href}
  target={linkTarget}
  rel={linkRel}
>
  {
    (icon || title) && (
      <div class="hz-card-head">
        {icon && <Icon name={icon} size={18} class="hz-card-icon" />}
        {title && <span class="hz-card-title">{title}</span>}
        {href && isExternal && <Icon name="arrow-up-right" size={13} class="hz-card-ext" />}
      </div>
    )
  }
  <div class="hz-card-body"><slot /></div>
</Tag>

<style>
  .hz-card {
    display: block;
    padding: 0.9rem 1rem;
    background: var(--color-surface);
    border: var(--border-default) solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-fg);
    text-decoration: none;
  }

  .hz-card[data-linked] {
    transition:
      transform 0.08s ease,
      box-shadow 0.08s ease,
      border-color 0.12s ease;
  }
  .hz-card[data-linked]:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-raised);
    border-color: var(--color-accent);
    color: var(--color-fg);
  }

  .hz-card-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.35rem;
  }
  .hz-card-icon {
    flex-shrink: 0;
    font-size: 1.1em;
    line-height: 1;
  }
  .hz-card-title {
    font-weight: 700;
    font-size: 1em;
  }
  .hz-card[data-linked]:hover .hz-card-title {
    color: var(--color-accent);
  }
  .hz-card-ext {
    color: var(--color-muted);
    flex-shrink: 0;
    margin-left: auto;
  }
  .hz-card-body {
    color: var(--color-muted);
    font-size: 0.92em;
  }
  .hz-card-body :global(p:first-child) { margin-top: 0; }
  .hz-card-body :global(p:last-child) { margin-bottom: 0; }
</style>
