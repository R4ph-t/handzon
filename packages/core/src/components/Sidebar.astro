---
import { withBase } from "../lib/base";
import type { TutorialEntry, StepEntry } from "../lib/content";
import { parseStepId } from "../lib/content";
import { STORAGE_KEY } from "../lib/progress/types";
import { fallbackTextForTrack, iconForTrack } from "../lib/track-icons";
import Progress from "./Progress.tsx";
import TrackSelector from "./TrackSelector.tsx";

interface Props {
  tutorial: TutorialEntry;
  steps: StepEntry[];
  currentStepSlug: string;
}

const { tutorial, steps, currentStepSlug } = Astro.props;
const slug = tutorial.id;
---
<aside class="sidebar" aria-label="Tutorial steps" data-gated={tutorial.data.gated ? "true" : "false"}>
  {/* Top block: back link, title, progress. Stays fixed while the
   * step list below scrolls when there are many steps. */}
  <div class="sb-top">
    <header class="sb-header">
      <a class="sb-back" href={withBase("/")}>← All tutorials</a>
      <h2 class="sb-title">
        <a href={withBase(`/${slug}`)}>{tutorial.data.title}</a>
      </h2>
      {tutorial.data.estimatedDuration && (
        <div class="sb-meta">{tutorial.data.estimatedDuration}</div>
      )}
    </header>

    {tutorial.data.showProgress && (
      <Progress tutorialSlug={slug} totalSteps={steps.length} client:load />
    )}
    {tutorial.data.tracks.length > 1 && (
      <div class="track-selector-shell">
        <section class="track-selector" aria-label="Tutorial track" data-track-fallback>
          <div class="track-selector-list">
            {tutorial.data.tracks.map((track: (typeof tutorial.data.tracks)[number]) => {
              const icon = iconForTrack(track);
              return (
                <button
                  type="button"
                  class="track-selector-option"
                  data-track-id={track.id}
                  data-active={track.id === (tutorial.data.defaultTrack ?? tutorial.data.tracks[0]?.id) ? "true" : "false"}
                  disabled
                >
                  {icon ? (
                    <svg class="track-selector-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path d={icon.path} />
                    </svg>
                  ) : (
                    <span class="track-selector-fallback" aria-hidden="true">
                      {fallbackTextForTrack(track)}
                    </span>
                  )}
                  <span>{track.label}</span>
                </button>
              );
            })}
          </div>
        </section>
        <TrackSelector
          tracks={tutorial.data.tracks}
          defaultTrack={tutorial.data.defaultTrack}
          client:only="react"
        />
      </div>
    )}
  </div>

  <ol class="sb-steps">
    {steps.map((step) => {
      const { stepSlug } = parseStepId(step.id);
      const isCurrent = stepSlug === currentStepSlug;
      return (
        <li class={isCurrent ? "is-current" : ""} data-step-slug={stepSlug}>
          <a href={withBase(`/${slug}/${stepSlug}`)} data-step-link="true">
            <span class="sb-check" data-step-key={`${slug}/${stepSlug}`}></span>
            <span class="sb-name">{step.data.title}</span>
            {step.data.duration && <span class="sb-dur">{step.data.duration}</span>}
            <span class="sb-lock" aria-hidden="true">Locked</span>
          </a>
        </li>
      );
    })}
  </ol>
</aside>

{/* Pre-paint: mirror the persisted progress state into the SSR sidebar
    before hydrated modules run, avoiding a step-change flash from
    0 / unchecked to the learner's real progress. */}
<script is:inline define:vars={{ storageKey: STORAGE_KEY, tutorialSlug: slug, totalSteps: steps.length, tutorialSteps: steps.map((step) => parseStepId(step.id).stepSlug), gated: tutorial.data.gated }}>
  (function () {
    try {
      var raw = window.localStorage.getItem(storageKey);
      var state = raw ? JSON.parse(raw) : null;
      var steps = (state && state.steps) || {};
      var completed = 0;
      var firstIncomplete = tutorialSteps.find(function (slug) {
        return steps[tutorialSlug + "/" + slug] !== "complete";
      });
      var lockStart = gated && firstIncomplete ? tutorialSteps.indexOf(firstIncomplete) + 1 : -1;

      document.querySelectorAll("[data-step-key]").forEach(function (el) {
        var key = el.getAttribute("data-step-key");
        var done = key && steps[key] === "complete";
        el.setAttribute("data-done", done ? "true" : "false");
        if (done && key.indexOf(tutorialSlug + "/") === 0) completed += 1;
      });
      if (lockStart > 0) {
        tutorialSteps.slice(lockStart).forEach(function (slug) {
          var item = document.querySelector('[data-step-slug="' + slug + '"]');
          if (item) item.setAttribute("data-locked", "true");
        });
      }

      var progress = document.querySelector(".sidebar .progress");
      if (!progress) return;
      var bounded = Math.min(completed, totalSteps);
      var pct = totalSteps > 0 ? Math.round((bounded / totalSteps) * 100) : 0;
      progress.setAttribute("aria-label", bounded + " of " + totalSteps + " steps complete");
      progress.setAttribute("aria-valuenow", String(bounded));
      var fill = progress.querySelector(".progress-fill");
      if (fill) fill.style.width = pct + "%";
      var label = progress.querySelector(".progress-label");
      if (label) label.textContent = bounded + " / " + totalSteps + " steps";
    } catch (e) {
      /* ignore — hydrated progress will correct the sidebar */
    }
  })();
</script>

<script>
  // Hydrate per-step check marks from localStorage without an island.
  import { getStore } from "../lib/progress/local";
  import { lockedStepSlugs } from "../lib/progress/gating";

  const sidebar = document.querySelector<HTMLElement>(".sidebar");
  const tutorialSlug = sidebar?.querySelector<HTMLElement>("[data-step-key]")?.dataset.stepKey?.split("/")[0];
  const gated = sidebar?.dataset.gated === "true";
  const tutorialSteps = Array.from(document.querySelectorAll<HTMLElement>("[data-step-slug]")).map(
    (el) => el.dataset.stepSlug!,
  );

  sidebar?.addEventListener("click", (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>(
      "[data-step-link][aria-disabled='true']",
    );
    if (link) e.preventDefault();
  });

  function refresh() {
    const store = getStore();
    const state = store.get();
    const locked =
      gated && tutorialSlug
        ? new Set(lockedStepSlugs({ tutorialSlug, stepSlugs: tutorialSteps, steps: state.steps }))
        : new Set<string>();
    document.querySelectorAll<HTMLElement>("[data-step-key]").forEach((el) => {
      const key = el.dataset.stepKey as `${string}/${string}`;
      const done = state.steps[key] === "complete";
      el.dataset.done = done ? "true" : "false";
    });
    document.querySelectorAll<HTMLElement>("[data-step-slug]").forEach((el) => {
      const stepSlug = el.dataset.stepSlug!;
      const link = el.querySelector<HTMLAnchorElement>("[data-step-link]");
      const isLocked = locked.has(stepSlug);
      el.dataset.locked = isLocked ? "true" : "false";
      if (!link) return;
      if (isLocked) {
        link.setAttribute("aria-disabled", "true");
        link.setAttribute("tabindex", "-1");
        link.setAttribute("title", "Complete previous steps to unlock this step.");
      } else {
        link.removeAttribute("aria-disabled");
        link.removeAttribute("tabindex");
        link.removeAttribute("title");
      }
    });
  }
  refresh();
  getStore().subscribe(refresh);
</script>

<style>
  /* Two-zone layout: `.sb-top` (back link + title + progress) stays
   * at the top; `.sb-steps` scrolls underneath when the list
   * overflows. The wrapping `.sidebar-wrap` handles sticky
   * positioning below the navbar; the sidebar fills it 100%. The
   * column divider against `.main` is drawn by `.layout`'s
   * background gradient, not a border here. */
  .sidebar {
    height: 100%;
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .sb-top {
    padding: 1rem 1rem 0.75rem;
    flex-shrink: 0;
  }
  .sb-header { margin-bottom: 1rem; }
  .sb-back {
    font-family: var(--font-mono);
    font-size: 0.75em;
    color: var(--color-muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .sb-back:hover { color: var(--color-accent); }
  .sb-title {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0.5rem 0 0.25rem;
    line-height: 1.2;
    min-height: calc(1.15rem * 1.2 * 2);
    text-wrap: balance;
  }
  .sb-title a { color: var(--color-fg); text-decoration: none; }
  .sb-meta {
    color: var(--color-muted);
    font-size: 0.72em;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }
  /* Horizontal padding lives on the <a>, not on `.sb-steps`, so the
   * current-step background fills the sidebar edge-to-edge instead of
   * leaving a 1rem gutter on either side. The list itself is flush. */
  .sb-steps {
    list-style: none;
    padding: 0 0 2rem;
    margin: 0.75rem 0 0;
    flex: 1;
    overflow-y: auto;
    border-top: var(--border-default) solid var(--color-border);
  }
  .sb-steps li + li {
    border-top: var(--border-default) solid var(--color-border);
  }
  /* Single-row grid (check + name) with the duration pinned absolutely
   * to the top-right corner. Pulling it out of the grid flow means the
   * title row gets the full cell height — checkbox and title stay
   * vertically centered together, and the duration doesn't crowd the
   * top of long, wrapping titles the way a stacked grid track did.
   * `padding-right` on `.sb-name` reserves space so wrapping titles
   * never collide with the corner-stamped duration. */
  .sb-steps a {
    position: relative;
    display: grid;
    grid-template-columns: 18px 1fr;
    align-items: center;
    column-gap: 0.6rem;
    padding: 1.05rem 1rem;
    color: var(--color-fg);
    text-decoration: none;
    font-size: 0.92em;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .sb-name { line-height: 1.3; padding-right: 3.25rem; }
  .sb-dur {
    position: absolute;
    top: 0.55rem;
    right: 1rem;
    line-height: 1;
  }
  .sb-steps a:hover {
    background: var(--color-surface);
    color: var(--color-fg);
  }
  .sb-steps li[data-locked="true"] a {
    cursor: not-allowed;
    opacity: 0.48;
  }
  .sb-steps li[data-locked="true"] a:hover {
    background: transparent;
    box-shadow: none;
  }
  .sb-steps li.is-current a {
    background: color-mix(in oklab, var(--color-accent) 40%, var(--color-bg));
    color: var(--color-fg);
    font-weight: 500;
  }
  .sb-steps li.is-current a:hover {
    background: color-mix(in oklab, var(--color-accent) 48%, var(--color-bg));
  }
  .sb-check {
    width: 14px;
    height: 14px;
    border: var(--border-default) solid var(--color-border-strong);
    display: inline-block;
  }
  .sb-check[data-done="true"],
  .sb-steps [data-step-key][data-done="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .sb-dur {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72em;
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .sb-lock {
    display: none;
    position: absolute;
    right: 1rem;
    bottom: 0.45rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.68em;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .sb-steps li[data-locked="true"] .sb-lock {
    display: inline;
  }
</style>
