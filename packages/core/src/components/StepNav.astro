---
import TutorialCompletion from "./TutorialCompletion.tsx";
import { withBase } from "../lib/base";
import type { StepEntry } from "../lib/content";
import { parseStepId } from "../lib/content";
import type { TutorialSummary } from "../lib/tutorialSummary";

interface Props {
  tutorialSlug: string;
  steps: StepEntry[];
  currentStepSlug: string;
  gated: boolean;
  hasCheckpoint: boolean;
  hasQuiz: boolean;
  nextTutorial?: TutorialSummary;
}

const { tutorialSlug, steps, currentStepSlug, gated, hasCheckpoint, hasQuiz, nextTutorial } =
  Astro.props;
const idx = steps.findIndex((s) => parseStepId(s.id).stepSlug === currentStepSlug);
const prev = idx > 0 ? steps[idx - 1] : null;
const next = idx >= 0 && idx < steps.length - 1 ? steps[idx + 1] : null;
const prevSlug = prev ? parseStepId(prev.id).stepSlug : null;
const nextSlug = next ? parseStepId(next.id).stepSlug : null;
const hasCompletionItem = hasCheckpoint || hasQuiz;
---
<nav class:list={["step-nav", !next && "step-nav-final"]} data-gated={gated && hasCompletionItem ? "true" : "false"} data-step-key={`${tutorialSlug}/${currentStepSlug}`}>
  <div>
    {prev && (
      <a class="sn-prev" href={withBase(`/${tutorialSlug}/${prevSlug}`)}>
        ← {prev.data.title}
      </a>
    )}
  </div>
  <div class="sn-slot">
    {next ? (
      <a class="sn-next" href={withBase(`/${tutorialSlug}/${nextSlug}`)} data-next-link="true">
        {hasCompletionItem ? "Continue" : "Next"}: {next.data.title} →
      </a>
    ) : (
      <TutorialCompletion
        client:load
        tutorialSlug={tutorialSlug}
        totalSteps={steps.length}
        nextTutorial={nextTutorial}
      />
    )}
  </div>
</nav>

<script>
  // Gating: if the host step contains a completion item AND tutorial is gated,
  // disable Next until the step is marked complete.
  import { getStore } from "../lib/progress/local";
  const nav = document.querySelector<HTMLElement>(".step-nav");
  if (nav && nav.dataset.gated === "true") {
    const next = nav.querySelector<HTMLAnchorElement>("[data-next-link]");
    if (next) {
      const key = nav.dataset.stepKey as `${string}/${string}`;
      const refresh = () => {
        const done = getStore().get().steps[key] === "complete";
        if (!done) {
          next.classList.add("is-disabled");
          next.setAttribute("aria-disabled", "true");
          next.addEventListener("click", blockClick);
        } else {
          next.classList.remove("is-disabled");
          next.removeAttribute("aria-disabled");
          next.removeEventListener("click", blockClick);
        }
      };
      function blockClick(e: Event) { e.preventDefault(); }
      refresh();
      getStore().subscribe(refresh);
    }
  }

  // Keyboard nav: ← prev, → next.
  document.addEventListener("keydown", (e) => {
    if (e.target instanceof HTMLElement && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;
    if (e.key === "ArrowLeft") {
      const prev = document.querySelector<HTMLAnchorElement>(".sn-prev");
      if (prev) window.location.href = prev.href;
    } else if (e.key === "ArrowRight") {
      const next = document.querySelector<HTMLAnchorElement>(".sn-next:not(.is-disabled)");
      if (next) window.location.href = next.href;
    }
  });
</script>

<style>
  .step-nav {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: var(--border-default, 2px) solid var(--color-border);
  }
  .step-nav-final {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(18rem, 1fr);
  }
  .sn-slot {
    display: flex;
    justify-content: flex-end;
  }
  .sn-prev, .sn-next {
    display: inline-block;
    padding: 0.7rem 1rem;
    border: var(--border-default, 2px) solid var(--color-fg);
    text-decoration: none;
    color: var(--color-fg);
    font-weight: 700;
    transition: transform 0.08s ease, box-shadow 0.08s ease;
  }
  .sn-prev:hover, .sn-next:hover:not(.is-disabled) {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-raised);
    color: var(--color-fg);
  }
  .sn-next { background: var(--color-accent); color: var(--color-accent-fg); border-color: var(--color-accent); }
  .sn-next:hover:not(.is-disabled) { color: var(--color-accent-fg); }
  .sn-next.is-disabled { opacity: 0.4; cursor: not-allowed; }
  :global(.tutorial-completion) {
    width: min(100%, 42rem);
    display: grid;
    gap: 0.9rem;
  }
  :global(.completion-status),
  :global(.completion-card) {
    border: var(--border-default, 2px) solid var(--color-border);
    background: var(--color-surface);
    padding: 1rem;
  }
  :global(.tutorial-completion.is-complete .completion-status) {
    border-color: var(--color-success, var(--color-accent));
    box-shadow: var(--shadow-raised);
  }
  :global(.completion-kicker),
  :global(.completion-card-label),
  :global(.completion-meta) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
  :global(.completion-status h2) {
    margin: 0.3rem 0 0.25rem;
    font-size: 1.25rem;
    line-height: var(--leading-heading, 1.2);
  }
  :global(.completion-status p),
  :global(.completion-card span) {
    margin: 0;
    color: var(--color-muted);
  }
  :global(.completion-actions) {
    display: grid;
    gap: 0.75rem;
  }
  :global(.completion-card) {
    display: grid;
    gap: 0.4rem;
    color: var(--color-fg);
    text-decoration: none;
  }
  :global(a.completion-card:hover) {
    border-color: var(--color-accent);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-raised);
  }
  :global(.completion-card-primary) {
    border-color: var(--color-accent);
  }
  :global(.completion-card strong) {
    font-size: 1.05rem;
  }
  :global(.tutorial-completion.is-locked .completion-status) {
    opacity: 0.48;
    filter: grayscale(1);
    cursor: not-allowed;
  }
  @media (max-width: 760px) {
    .step-nav,
    .step-nav-final {
      display: grid;
      grid-template-columns: 1fr;
    }
    .sn-slot {
      justify-content: stretch;
    }
    :global(.tutorial-completion) {
      width: 100%;
    }
  }
</style>
