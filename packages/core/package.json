{
  "name": "handzon-core",
  "version": "0.8.2",
  "description": "Core framework for Handzon — layouts, components, content + AI libs, and server runtime (handlers, DB, auth, migration runner) consumed by Handzon scaffolds.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "r4ph_t",
  "homepage": "https://github.com/R4ph-t/handzon#readme",
  "bugs": {
    "url": "https://github.com/R4ph-t/handzon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/R4ph-t/handzon.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "files": [
    "src",
    "styles",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./collections.ts": "./src/collections.ts",
    "./components/*": "./src/components/*",
    "./components/auth/*": "./src/components/auth/*",
    "./layouts/*": "./src/layouts/*",
    "./lib/*": "./src/lib/*",
    "./pages/*": "./src/pages/*",
    "./server/*": "./src/server/*",
    "./server/auth/*": "./src/server/auth/*",
    "./styles/*": "./styles/*"
  },
  "scripts": {
    "build": "echo 'handzon-core ships source — Astro type-checks at consume time'"
  },
  "peerDependencies": {
    "astro": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@auth/core": "^0.37.3",
    "@auth/drizzle-adapter": "^1.11.2",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.1.6",
    "auth-astro": "^4.2.0",
    "cookie": "^1.0.2",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.15.0",
    "postgres": "^3.4.9",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "unist-util-visit": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.3.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
