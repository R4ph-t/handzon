---
import type { TutorialEntry } from "../../lib/content";

interface Props {
  tutorial: TutorialEntry;
  duration?: string;
}
const { tutorial, duration } = Astro.props;
const data = tutorial.data;
const slug = tutorial.id;
---
<article class="card" data-difficulty={data.difficulty} data-tags={data.tags.join(",")} data-search={`${data.title} ${data.description} ${data.tags.join(" ")}`.toLowerCase()}>
  <a href={`/${slug}`} class="card-link">
    <div class="card-body">
      <div class="badges">
        <span class={`badge badge-${data.difficulty}`}>{data.difficulty}</span>
        {duration && <span class="badge badge-neutral">{duration}</span>}
      </div>
      <h3>{data.title}</h3>
      <p>{data.description}</p>
      {data.tags.length > 0 && (
        <div class="tags">
          {data.tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
      )}
      <div class="card-progress" data-tutorial-slug={slug}></div>
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    display: flex;
    transition: border-color 0.12s ease, transform 0.12s ease;
  }
  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .card-link {
    color: var(--color-fg);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .card-body {
    padding: 1.1rem 1.2rem 1.2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* Top row: difficulty + duration. One muted scale, no semantic
   * colour bombs — the difficulty pill carries a small accent dot
   * instead of a full-colour border so the cards read as a family. */
  .badges {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.18rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }
  .badge-beginner::before,
  .badge-intermediate::before,
  .badge-advanced::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }
  .badge-beginner { color: var(--color-success); }
  .badge-intermediate { color: var(--color-warn); }
  .badge-advanced { color: var(--color-danger); }

  h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92em;
    line-height: 1.5;
    /* Clamp to 3 lines so cards stay the same height regardless of
     * description length. Keeps the grid visually consistent. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tags — quiet, hash-prefixed, sit just above the progress strip.
   * margin-top: auto pushes them to the bottom of a flexed card so
   * shorter descriptions don't leave dead space mid-card. */
  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.7em;
    color: var(--color-muted);
  }

  .card-progress:not(:empty) { padding-top: 0.5rem; }
</style>
