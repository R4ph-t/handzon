---
interface Props {
  src: string;
  title?: string;
  aspect?: string;
  type?: "iframe" | "video";
}
const { src, title = "Embedded content", aspect = "16/9", type = "iframe" } = Astro.props;

function normalize(url: string): string {
  try {
    const u = new URL(url, "https://example.com");
    if (u.hostname.endsWith("youtube.com")) {
      u.hostname = "www.youtube-nocookie.com";
      return u.toString();
    }
    return url;
  } catch {
    return url;
  }
}

const finalSrc = type === "iframe" ? normalize(src) : src;
---
<div class="embed" style={`aspect-ratio: ${aspect};`}>
  {type === "iframe" ? (
    <iframe
      src={finalSrc}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    />
  ) : (
    <video controls preload="metadata">
      <source src={finalSrc} />
    </video>
  )}
</div>

<style>
  .embed {
    margin: 1.5rem 0;
    border: var(--border-default, 2px) solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
  }
  .embed iframe,
  .embed video {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
