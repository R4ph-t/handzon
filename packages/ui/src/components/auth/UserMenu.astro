---
/**
 * Server-rendered auth menu. Renders nothing when Auth.js isn't wired
 * (no AUTH_SECRET in env, or `auth-astro` integration not registered).
 *
 * All auth-astro and session imports are deferred via dynamic import
 * so scaffolds that haven't opted into GitHub auth never trigger the
 * `auth:config` virtual module — which only exists when the
 * `auth-astro` integration has set it up. Without this dance, BaseLayout
 * crashes any consumer that upgrades handzon-ui without wiring auth.
 */
type AuthedUser = {
  userId: string;
  email: string | null;
  name: string | null;
  image: string | null;
};

const authEnabled = Boolean(process.env.AUTH_SECRET);

let authed: AuthedUser | null = null;
let SignIn: unknown = null;
let SignOut: unknown = null;

if (authEnabled) {
  try {
    const [components, session] = await Promise.all([
      import("auth-astro/components"),
      import("../../server/auth/session.ts"),
    ]);
    SignIn = components.SignIn;
    SignOut = components.SignOut;
    authed = await session.getAuthedUser(Astro.request);
  } catch {
    // auth-astro isn't wired in this scaffold — degrade to "hidden"
    // rather than crashing every page that uses BaseLayout.
    SignIn = null;
    SignOut = null;
  }
}

const ready = authEnabled && SignIn && SignOut;
const SignInTag = SignIn as never;
const SignOutTag = SignOut as never;
---
{ready && (
  <div class="user-menu">
    {authed ? (
      <>
        {authed.image && (
          <img class="um-avatar" src={authed.image} alt="" width="24" height="24" />
        )}
        <span class="um-name">{authed.name ?? authed.email ?? "Signed in"}</span>
        <SignOutTag class="um-btn">Sign out</SignOutTag>
      </>
    ) : (
      <SignInTag provider="github" class="um-btn">Sign in with GitHub</SignInTag>
    )}
  </div>
)}

<style is:global>
  .user-menu {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8em;
  }
  .um-avatar {
    border-radius: 50%;
    border: 1px solid var(--color-border);
    display: block;
  }
  .um-name {
    color: var(--color-fg);
    max-width: 12ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .um-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    background: transparent;
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .um-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
