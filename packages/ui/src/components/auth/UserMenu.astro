---
/**
 * Server-rendered auth menu. Renders nothing unless the `auth-astro`
 * integration is registered in the consumer's astro.config.
 *
 * The dynamic imports of `auth-astro/components` + the session helper
 * succeed only when auth-astro's integration has set up the
 * `auth:config` virtual module. When the consumer hasn't opted in,
 * both imports throw — the catch swallows the error and the menu
 * renders nothing instead of crashing BaseLayout.
 *
 * We deliberately don't gate on `process.env.AUTH_SECRET`: Astro/Vite
 * only auto-load .env into `import.meta.env` (and only `PUBLIC_*` are
 * exposed there), so the env check returned false on scaffolds where
 * auth IS wired but AUTH_SECRET isn't visible to process.env at SSR
 * time. The integration-registration check is the right signal.
 */
type AuthedUser = {
  userId: string;
  email: string | null;
  name: string | null;
  image: string | null;
};

let authed: AuthedUser | null = null;
let SignIn: unknown = null;
let SignOut: unknown = null;

try {
  const [components, session] = await Promise.all([
    import("auth-astro/components"),
    import("../../server/auth/session.ts"),
  ]);
  SignIn = components.SignIn;
  SignOut = components.SignOut;
  authed = await session.getAuthedUser(Astro.request);
} catch {
  // auth-astro isn't wired in this scaffold — render nothing.
}

const ready = SignIn && SignOut;
const SignInTag = SignIn as never;
const SignOutTag = SignOut as never;
---
{ready && (
  <div class="user-menu">
    {authed ? (
      <>
        {authed.image ? (
          <img
            class="um-avatar"
            src={authed.image}
            alt={authed.name ?? authed.email ?? "Signed in"}
            width="24"
            height="24"
          />
        ) : (
          <span class="um-avatar um-avatar-fallback" aria-hidden="true">
            {(authed.name ?? authed.email ?? "?").trim().charAt(0).toUpperCase()}
          </span>
        )}
        <span class="um-name">{authed.name ?? authed.email ?? "Signed in"}</span>
        <SignOutTag class="um-btn um-btn-icon" title="Sign out">
          <svg
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          <span class="sr-only">Sign out</span>
        </SignOutTag>
      </>
    ) : (
      <SignInTag provider="github" class="um-btn">
        <svg
          class="um-gh"
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.02c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.03 0 0 .96-.31 3.15 1.17a10.94 10.94 0 0 1 5.76 0c2.19-1.48 3.15-1.17 3.15-1.17.62 1.58.23 2.74.11 3.03.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.37-5.25 5.65.41.35.78 1.04.78 2.11v3.13c0 .3.21.66.79.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
        </svg>
        <span>Sign in with GitHub</span>
      </SignInTag>
    )}
  </div>
)}

<style is:global>
  .user-menu {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8em;
  }
  .um-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    display: inline-block;
    object-fit: cover;
    flex-shrink: 0;
  }
  .um-avatar-fallback {
    background: color-mix(in oklab, var(--color-accent) 15%, var(--color-bg));
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.75em;
    display: inline-grid;
    place-items: center;
  }
  .um-name {
    color: var(--color-fg);
    max-width: 12ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .um-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    background: transparent;
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .um-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .um-btn-icon {
    padding: 0.3rem 0.45rem;
  }
  .um-gh {
    flex-shrink: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
