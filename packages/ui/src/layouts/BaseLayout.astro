---
import UserMenu from "../components/auth/UserMenu.astro";

interface Props {
  title?: string;
  description?: string;
  siteName?: string;
  tagline?: string;
  /**
   * URL of the brand logo shown top-left. Defaults to `/logo.svg` —
   * the scaffold ships a starter at `public/logo.svg` which users
   * can replace to rebrand without touching framework code. Pass an
   * empty string to hide the brand mark.
   */
  logoUrl?: string;
}
const {
  title,
  description,
  siteName = "Handzon",
  tagline = "Hands-on tutorials",
  logoUrl = "/logo.svg",
} = Astro.props;
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const desc = description ?? tagline;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    {logoUrl && (
      <div class="hz-brand">
        <a href="/" aria-label={`${siteName} home`}>
          <img src={logoUrl} alt={siteName} width="28" height="28" />
        </a>
      </div>
    )}
    <div class="hz-topbar">
      <UserMenu />
    </div>
    <slot />
    <script>
      // Render any <pre class="mermaid"> blocks emitted by rehype-mermaid.
      if (document.querySelector("pre.mermaid")) {
        import("mermaid").then(({ default: mermaid }) => {
          mermaid.initialize({ startOnLoad: false, theme: "dark", securityLevel: "strict" });
          mermaid.run({ querySelector: "pre.mermaid" });
        });
      }
    </script>

    <style is:global>
      .hz-brand {
        position: fixed;
        top: 0.75rem;
        left: 0.9rem;
        z-index: 50;
      }
      .hz-brand a {
        display: block;
        line-height: 0;
        opacity: 0.9;
        transition: opacity 0.15s ease;
      }
      .hz-brand a:hover {
        opacity: 1;
      }
      .hz-brand img {
        display: block;
      }
      .hz-topbar {
        position: fixed;
        top: 0.75rem;
        right: 0.9rem;
        z-index: 50;
      }
      /* Hide the topbar slot entirely when its child renders nothing
       * (auth disabled) so we don't reserve dead space. */
      .hz-topbar:empty {
        display: none;
      }
    </style>
  </body>
</html>
