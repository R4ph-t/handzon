---
import Navbar from "../components/Navbar.astro";
import UserMenu from "../components/auth/UserMenu.astro";

interface Props {
  title?: string;
  description?: string;
  siteName?: string;
  tagline?: string;
  /**
   * Top navigation mode:
   *  - "full": Navbar with logo + UserMenu (default — every page).
   *  - "userMenu": floating UserMenu only, no logo. For the homepage
   *    where the Hero already shows the brand inline.
   *  - "none": no nav at all.
   */
  nav?: "full" | "userMenu" | "none";
  /** Logo URL passed to Navbar (when nav === "full"). */
  logoUrl?: string;
}
const {
  title,
  description,
  siteName = "Handzon",
  tagline = "Hands-on tutorials",
  nav = "full",
  logoUrl = "/logo.svg",
} = Astro.props;
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const desc = description ?? tagline;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    {nav === "full" && (
      <Navbar logoUrl={logoUrl} siteName={siteName} />
    )}
    {nav === "userMenu" && (
      <div class="hz-topbar">
        <UserMenu />
      </div>
    )}
    <slot />
    <script>
      // Render any <pre class="mermaid"> blocks emitted by rehype-mermaid.
      if (document.querySelector("pre.mermaid")) {
        import("mermaid").then(({ default: mermaid }) => {
          mermaid.initialize({ startOnLoad: false, theme: "dark", securityLevel: "strict" });
          mermaid.run({ querySelector: "pre.mermaid" });
        });
      }
    </script>

    <style is:global>
      .hz-topbar {
        position: fixed;
        top: 0.75rem;
        right: 0.9rem;
        z-index: 50;
      }
      .hz-topbar:empty {
        display: none;
      }
    </style>
  </body>
</html>
