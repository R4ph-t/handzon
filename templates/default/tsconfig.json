{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    },
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "drizzle.config.ts",
    "astro.config.mjs",
    "src/env.d.ts"
  ],
  "exclude": ["dist", "node_modules", "services"]
}
