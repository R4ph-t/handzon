## AI assistant service (templates/default/services/ai)
##
## PORT / HOST
##   Render injects PORT automatically. HOST defaults to 0.0.0.0.
# PORT=4111
# HOST=0.0.0.0

## ALLOWED_ORIGIN
##   Comma-separated list of origins allowed to call /chat. Each item is
##   either:
##     1. A bare hostname like "my-site-abc" — expanded to
##        `https://<host>.onrender.com`. This is what
##        `fromService.property: host` ships in render.yaml.
##     2. A full origin like `https://mysite.com` or `http://localhost:4321`.
##        Used as-is.
##   When unset, CORS falls back to "*" (acceptable only for local dev;
##   the Blueprints set this for you in production).
ALLOWED_ORIGIN=http://localhost:4321

## Provider API keys
##   Used as a fallback when the learner has not supplied a BYOK key via
##   the X-Llm-Api-Key header. Leave unset to force BYOK-only.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
