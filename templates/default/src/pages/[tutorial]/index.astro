---
export const prerender = true;
import "~/styles/global.css";
import TutorialLandingPage from "handzon-core/pages/TutorialLanding.astro";
import { getTutorialLandingPaths } from "handzon-core/pages/paths.ts";
import { site } from "~/config/site";

export const getStaticPaths = getTutorialLandingPaths;

const { tutorial } = Astro.props;
---
<TutorialLandingPage
  tutorial={tutorial}
  siteName={site.name}
  tagline={site.tagline}
  logoUrl={site.logo}
  faviconUrl={site.favicon}
  repoUrl={site.repoUrl}
/>
