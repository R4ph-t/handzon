---
export const prerender = true;
import "~/styles/global.css";
import TutorialLandingPage from "handzon/pages/TutorialLanding.astro";
import { getTutorialLandingPaths } from "handzon/pages/paths.ts";
import { site } from "~/config/site";

export const getStaticPaths = getTutorialLandingPaths;

const { tutorial } = Astro.props;
---
<TutorialLandingPage
  tutorial={tutorial}
  siteName={site.name}
  tagline={site.tagline}
/>
