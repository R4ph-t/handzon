---
export const prerender = true;
import "~/styles/global.css";
import TutorialStepPage from "handzon/pages/TutorialStep.astro";
import { getTutorialStepPaths } from "handzon/pages/paths.ts";
import { aiDefaults } from "~/config/ai";

export const getStaticPaths = getTutorialStepPaths;

const { tutorial, steps, currentStep } = Astro.props;
---
<TutorialStepPage
  tutorial={tutorial}
  steps={steps}
  currentStep={currentStep}
  aiDefaults={aiDefaults}
/>
