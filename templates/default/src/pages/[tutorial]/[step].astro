---
export const prerender = true;
import "~/styles/global.css";
import TutorialStepPage from "handzon-ui/pages/TutorialStep.astro";
import { getTutorialStepPaths } from "handzon-ui/pages/paths.ts";
import { aiDefaults } from "~/config/ai";
import { site } from "~/config/site";

export const getStaticPaths = getTutorialStepPaths;

const { tutorial, steps, currentStep } = Astro.props;
---
<TutorialStepPage
  tutorial={tutorial}
  steps={steps}
  currentStep={currentStep}
  aiDefaults={aiDefaults}
  siteName={site.name}
  tagline={site.tagline}
  logoUrl={site.logo}
  faviconUrl={site.favicon}
  repoUrl={site.repoUrl}
/>
