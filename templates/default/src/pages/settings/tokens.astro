---
import "~/styles/global.css";
import BaseLayout from "handzon-core/layouts/BaseLayout.astro";
import SignInButton from "handzon-core/components/auth/SignInButton.astro";
import { GITHUB_ICON_PATH } from "handzon-core/lib/icons.ts";
import { getAuthedUser } from "handzon-core/server/auth/session.ts";
import { isSameOrigin } from "handzon-core/server/http.ts";
import {
  createToken,
  KNOWN_SCOPES,
  listTokens,
  revokeToken,
  type Scope,
} from "handzon-core/server/tokens.ts";
import { site } from "~/config/site";
import EditorInstall from "./_EditorInstall.astro";

const user = await getAuthedUser(Astro.request);

// Action results surfaced to the rendered page: a freshly-minted
// raw token (shown once) and any error from the latest POST.
let mintedRaw: string | null = null;
let mintedName: string | null = null;
let formError: string | null = null;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request)) {
    formError = "Cross-origin write rejected.";
  } else if (!user) {
    formError = "Sign in to manage tokens.";
  } else {
    const form = await Astro.request.formData();
    const action = String(form.get("action") ?? "");
    if (action === "create") {
      const name = String(form.get("name") ?? "").trim();
      const scopes = form
        .getAll("scopes")
        .map((s) => String(s))
        .filter((s): s is Scope => (KNOWN_SCOPES as readonly string[]).includes(s));
      if (!name) {
        formError = "Name is required.";
      } else if (scopes.length === 0) {
        formError = "Pick at least one scope.";
      } else {
        const { raw } = await createToken({ userId: user.userId, name, scopes });
        mintedRaw = raw;
        mintedName = name;
      }
    } else if (action === "revoke") {
      const tokenId = String(form.get("tokenId") ?? "");
      if (tokenId) await revokeToken(user.userId, tokenId);
    } else {
      formError = "Unknown action.";
    }
  }
}

const tokens = user ? await listTokens(user.userId) : [];

// MCP install context — passed to <EditorInstall>. The `mcp.json` server
// key is slugified from `site.name` so two Handzon sites in the same
// config don't collide on "handzon".
const origin = Astro.url.origin;
const mcpServerName =
  site.name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "") || "handzon";
const tokenPlaceholder = "hzn_pat_xxxxxxxxxxxxxxxxxxxxxxxx";
---
<BaseLayout
  title="MCP setup"
  siteName={site.name}
  tagline={site.tagline}
  logoUrl={site.logo}
  faviconUrl={site.favicon}
  repoUrl={site.repoUrl}
>
  <main class="tokens-page">
    <header class="prose">
      <h1>MCP setup</h1>
      <p>
        Connect this tutorial site to Cursor, Claude Code, Codex, Claude
        Desktop, or any other MCP-aware editor. Your agent can start tutorials
        from a blank workspace, browse steps, mark checkpoints, record quiz
        results, and send help requests to the in-browser tutor.
      </p>
    </header>

    <section class="card">
      <h2>How it works</h2>
      <div class="prose">
        <ol>
          <li>Create a scoped personal access token for this site.</li>
          <li>Install the site's MCP server in your editor.</li>
          <li>
            Ask your agent to use the Handzon MCP server while you work through
            a tutorial.
          </li>
        </ol>
        <p>
          Tokens are scoped. A token with <code>progress:write</code> can make
          the same progress updates your browser session can make, so treat it
          like a password.
        </p>
      </div>
    </section>

    {!user && (
      <section class="card">
        <div class="prose">
          <p>Sign in with GitHub to create a token and unlock one-click setup.</p>
        </div>
        <SignInButton provider="github">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d={GITHUB_ICON_PATH} />
          </svg>
          <span>Sign in with GitHub</span>
        </SignInButton>
      </section>
    )}

    {user && mintedRaw && (
      <section class="card card-emph" role="status">
        <h2>Token created</h2>
        <div class="prose">
          <p>
            Here is your new token for <strong>{mintedName}</strong>. It will
            only be shown once. Copy it now, or use one of the install paths
            below (the token is already baked into every option).
          </p>
        </div>
        <pre class="token" data-copy>{mintedRaw}</pre>

        <h3>Install in your editor</h3>
        <EditorInstall
          token={mintedRaw}
          serverName={mcpServerName}
          origin={origin}
        />
      </section>
    )}

    {user && formError && (
      <div class="card card-err" role="alert">
        <p>{formError}</p>
      </div>
    )}

    {user && (
      <section class="card">
        <h2>1. Create a token</h2>
        <div class="prose">
          <p>
            Pick the smallest scope that fits your workflow. Use
            <code>progress:read</code> for browsing tutorial state, and add
            <code>progress:write</code> when your agent should mark progress or
            submit verification results.
          </p>
        </div>
        <form method="POST" class="create-token-form">
          <input type="hidden" name="action" value="create" />
          <label>
            <span>Name</span>
            <input type="text" name="name" required maxlength="64" placeholder="Cursor on my laptop" />
          </label>
          <fieldset>
            <legend>Scopes</legend>
            {KNOWN_SCOPES.map((s) => (
              <label class="check">
                <input type="checkbox" name="scopes" value={s} />
                <span>{s}</span>
              </label>
            ))}
          </fieldset>
          <button class="sib" type="submit">Create token</button>
        </form>
      </section>
    )}

    <section class="card">
      <h2>2. Connect your editor</h2>
      <div class="prose">
        <p>
          Choose your editor to get the right install command or config block.
          If you already have a token, replace <code>{tokenPlaceholder}</code>{" "}
          in the snippet with that value. If you lost the raw token value,
          create a fresh token above.
        </p>
      </div>

      <EditorInstall
        token={tokenPlaceholder}
        serverName={mcpServerName}
        origin={origin}
      />

      <h3>What the agent can do</h3>
      <div class="prose">
        <ul>
          <li>
            <strong>Reads</strong> (any token, or no token):{" "}
            <code>list_tutorials</code>, <code>get_tutorial</code>,{" "}
            <code>start_tutorial</code>, <code>get_step</code>,{" "}
            <code>get_progress</code>.
          </li>
          <li>
            <strong>Writes</strong> (need <code>progress:write</code>):{" "}
            <code>complete_checkpoint</code>, <code>uncheck_checkpoint</code>,{" "}
            <code>complete_step</code>, <code>mark_step_incomplete</code>,{" "}
            <code>record_quiz</code>, <code>set_last_visited</code>,{" "}
            <code>set_preference</code>, <code>request_help</code>,{" "}
            <code>submit_verification</code>.
          </li>
        </ul>
        <p>
          <code>request_help</code> is the bridge. The editor agent can say
          "the learner is stuck on X" and the message lands in the in-browser
          tutor's inbox the next time you open the tab.
        </p>
      </div>
    </section>

    {user && (
      <section class="card">
        <h2>Manage tokens ({tokens.length})</h2>
        {tokens.length === 0 ? (
          <p class="muted">No tokens yet.</p>
        ) : (
          <ul class="token-list">
            {tokens.map((t) => (
              <li>
                <div class="token-row">
                  <strong>{t.name}</strong>
                  <span class="muted">
                    {t.scopes.join(", ")}
                    {" · "}
                    created {t.createdAt.toISOString().slice(0, 10)}
                    {t.lastUsedAt ? ` · last used ${t.lastUsedAt.toISOString().slice(0, 10)}` : " · never used"}
                    {t.expiresAt ? ` · expires ${t.expiresAt.toISOString().slice(0, 10)}` : ""}
                  </span>
                </div>
                <form method="POST" class="token-revoke">
                  <input type="hidden" name="action" value="revoke" />
                  <input type="hidden" name="tokenId" value={t.id} />
                  <button class="sib" type="submit">Revoke</button>
                </form>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}
  </main>
</BaseLayout>

<script>
  // Copy-to-clipboard for the raw token (the one `<pre data-copy>` left
  // on the page after migrating snippets to Expressive Code — EC ships
  // its own copy button so all other snippets are covered). Falls back
  // to "Copy failed" if the Clipboard API is unavailable (insecure
  // context / older browser).
  for (const pre of document.querySelectorAll<HTMLPreElement>("pre[data-copy]")) {
    const wrap = document.createElement("div");
    wrap.className = "copy-wrap";
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy-btn";
    btn.textContent = "Copy";
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? "");
        btn.textContent = "Copied!";
        setTimeout(() => {
          btn.textContent = "Copy";
        }, 1500);
      } catch {
        btn.textContent = "Copy failed";
      }
    });
    wrap.appendChild(btn);
  }
</script>

<style>
  /* Match the navbar + footer column convention used by every other
     page: BaseLayout's pageMaxWidth defaults to "none" so those bars
     span the viewport, and each page constrains its OWN content here.
     The 48rem column reads well for a forms-and-snippets page; nav
     stays aligned to the wider 80rem default fallback. */
  .tokens-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
    display: grid;
    gap: 1.25rem;
  }
  /* Let the article fill the card. handzon-core's .prose default of
     `max-width: 72ch` is for free-flowing tutorial body text where
     line length matters more than container alignment — but on a
     forms-and-cards page that gives a visible mismatch (text wraps
     well before the card's right edge). The container is already the
     readability constraint here. */
  .tokens-page .prose { max-width: none; }
  /* Card chrome — heading lives outside .prose so it doesn't pick up
     the prose's border-top-on-h2 rule (designed for tutorial body
     content, not card titles). */
  .card {
    background: var(--color-surface);
    border: var(--border-default) solid var(--color-border);
    padding: 1rem 1.25rem;
  }
  .card-emph { border-left: var(--border-thick) solid var(--color-success); }
  .card-err  { border-left: var(--border-thick) solid var(--color-danger, #ff4d4f); }
  .card h2 { margin: 0 0 0.4rem; }
  .card h3 { margin: 1.2rem 0 0.4rem; font-size: 1.05em; }

  .muted { color: var(--color-muted); }

  .token {
    background: var(--color-bg);
    border: var(--border-default) solid var(--color-border);
    padding: 0.6rem 0.8rem;
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
    margin: 0.4rem 0 0.6rem;
  }

  /* Scope the create-token form's grid layout so it doesn't leak into
     other forms on the page (revoke, SignInButton's <form>). */
  .create-token-form { display: grid; gap: 0.75rem; }
  .create-token-form label { display: grid; gap: 0.25rem; }
  .create-token-form label > span { font-size: 0.8em; color: var(--color-muted); }
  .create-token-form input[type="text"] {
    background: var(--color-bg);
    border: var(--border-default) solid var(--color-border);
    padding: 0.45rem 0.6rem;
    color: var(--color-fg);
    font: inherit;
  }
  .create-token-form fieldset { border: var(--border-default) solid var(--color-border); padding: 0.65rem; }
  .create-token-form .check { display: inline-flex; gap: 0.4rem; margin-right: 1rem; align-items: center; }

  .token-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .token-list li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }
  .token-list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .token-row { display: grid; gap: 0.15rem; }

  /* The Sign in / Revoke / Create token buttons all use .sib (the
     handzon-core themed sign-in button class) so they share one look.
     Keep their padding consistent with form rhythm. */
  .create-token-form .sib,
  .token-revoke .sib {
    width: fit-content;
  }
</style>

<!-- Copy-button styling for the raw token pre (the only `pre[data-copy]`
     left after the EC migration). The wrap + button are created by the
     script above and never receive Astro's scoping hash, so the rules
     must be global to reach them. -->
<style is:global>
  .copy-wrap { position: relative; }
  .copy-btn {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    background: var(--color-surface);
    color: var(--color-fg);
    border: var(--border-default) solid var(--color-border);
    padding: 0.2rem 0.55rem;
    font: inherit;
    font-size: 0.75em;
    cursor: pointer;
  }
  .copy-btn:hover { background: var(--color-bg); }
</style>
