## Site (templates/default)
##
## SITE_URL          Public origin of the site. Used by Astro for absolute
##                   URLs (sitemaps, OG meta). Falls back to localhost.
SITE_URL=http://localhost:4321

## PUBLIC_AI_SERVICE_URL
##   Two accepted shapes:
##     1. A bare Render private-network hostname like "my-project-ai-abc".
##        The browser will rebuild it as `https://<host>.onrender.com`.
##        This is what `fromService.property: host` ships in render.yaml.
##     2. A fully-qualified URL like `https://helper.mysite.com` or
##        `http://localhost:4111`. Used as-is. Use this for local dev and
##        for custom domains.
PUBLIC_AI_SERVICE_URL=http://localhost:4111

## PUBLIC_PROGRESS_BACKEND
##   - "local"  (default) — progress lives in localStorage. No DB needed.
##   - "remote" — mirrors writes to /api/progress (requires DATABASE_URL).
PUBLIC_PROGRESS_BACKEND=local

## DATABASE_URL
##   Postgres connection string. Only required when PUBLIC_PROGRESS_BACKEND
##   is "remote". On Render, wire this from a fromDatabase block.
# DATABASE_URL=postgres://user:pass@host:5432/db
